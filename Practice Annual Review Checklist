</style>


<script>

function calculateAnnualReview(){

const checks =
document.querySelectorAll(
'#annualReviewForm input[type=""checkbox""]'
);

const total = checks.length;

let completed = 0;

checks.forEach(function(check){

if(check.checked){

completed++;

}

});

const score =
Math.round((completed / total) * 100);

let status = """";
let message = """";

if(score < 50){

status = ""Annual Review Needed"";

message =
""Several important areas of your practice may need attention. Consider setting aside dedicated time to review your finances, systems, workload, and goals."";

}
else if(score < 75){

status = ""Review in Progress"";

message =
""You have reviewed several important areas of your practice. Focus on the remaining gaps and turn your findings into specific priorities for the coming year."";

}
else if(score < 90){

status = ""Strong Annual Review"";

message =
""Your practice appears to have a solid annual review process. Consider turning the remaining items into measurable goals for the year ahead."";

}
else{

status = ""Well Prepared"";

message =
""You have completed most major areas of your annual practice review and are well positioned to plan the year ahead."";

}

document.getElementById(
""annualReviewResults""
).innerHTML =

'<div class=""annual-result-box"">' +

'<div>Annual Review Completion</div>' +

'<div class=""annual-score"">' +
score +
'%</div>' +

'<div class=""annual-status"">' +
status +
'</div>' +

'<div class=""annual-message"">' +
message +
'</div>' +

'</div>';

}

</script>"
