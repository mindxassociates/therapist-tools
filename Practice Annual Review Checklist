color:#0d2d50;
margin-bottom:10px;
}

#mindx-practice-annual-review .subtitle{
text-align:center;
color:#6d7786;
line-height:1.6;
margin-bottom:30px;
}

#mindx-practice-annual-review .section{
background:white;
padding:20px;
border-radius:14px;
margin-bottom:16px;
}

#mindx-practice-annual-review h3{
color:#17314f;
font-size:18px;
margin-top:0;
margin-bottom:15px;
}

