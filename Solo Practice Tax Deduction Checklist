<style>

#mindx-tax-deduction-checklist{
max-width:800px;
margin:auto;
padding:30px;
background:#f8f9fc;
border-radius:20px;
font-family:'Segoe UI',sans-serif;
}

#mindx-tax-deduction-checklist h2{
