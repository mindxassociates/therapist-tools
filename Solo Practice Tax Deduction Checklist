<script>

const checkboxes =
document.querySelectorAll(
'#mindx-tax-deduction-checklist .item'
);

function updateChecklist(){

const total =
checkboxes.length;

const checked =
document.querySelectorAll(
'#mindx-tax-deduction-checklist .item:checked'
).length;

const percent =
Math.round(
(checked / total) * 100
);

document.getElementById(
'completionScore'
).innerText =
percent + '%';

let status = '';

if(percent < 25){

status =
'Start reviewing potential deductions.';

}else if(percent < 50){

status =
'You have identified several potential categories.';

}else if(percent < 75){

status =
'Good progress. Consider reviewing documentation and receipts.';

}else{

status =
'Comprehensive review completed. Consider discussing with your accountant.';

}

document.getElementById(
'statusText'
).innerText =
status;

}

checkboxes.forEach(box => {

box.addEventListener(
'change',
updateChecklist
);

});

updateChecklist();

</script>"
