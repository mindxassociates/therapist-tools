</style>


<script>

function checkMedicalNecessity(){

const checks =
document.querySelectorAll(
'#medicalNecessityForm input[type=""checkbox""]'
);

const total = checks.length;

let completed = 0;

checks.forEach(function(check){

if(check.checked){

completed++;

}

});

const score =
Math.round((completed / total) * 100);

let status = """";
let message = """";

if(score < 50){

status = ""Significant Gaps"";

message =
""Several core elements supporting clinical rationale and medical necessity may be missing. Review the note before finalizing it."";

}
else if(score < 75){

status = ""Needs Strengthening"";

message =
""The note contains some important elements, but additional clinical detail may be needed to clearly connect symptoms, functioning, interventions, and treatment goals."";

}
else if(score < 90){

status = ""Generally Well Documented"";

message =
""Most key documentation elements are present. Review any remaining gaps and make sure the clinical rationale is clear and specific."";

}
else{

status = ""Strong Documentation"";

message =
""The note includes most of the core elements that can support a clear clinical narrative. Continue reviewing the note against applicable payer and practice requirements."";

}

document.getElementById(
""medicalNecessityResults""
).innerHTML =

'<div class=""medical-result-box"">' +

'<div>Documentation Support Score</div>' +

'<div class=""medical-score"">' +
score +
'%</div>' +

'<div class=""medical-status"">' +
status +
'</div>' +

'<div class=""medical-message"">' +
message +
'</div>' +

'<div class=""medical-warning"">' +
'This score reflects documentation completeness only. A high score does not establish medical necessity or guarantee payment.' +
'</div>' +

'</div>';

}

</script>"
