color:#0d2d50;
margin-bottom:10px;
}

#mindx-medical-necessity-checker .subtitle{
text-align:center;
color:#6d7786;
line-height:1.6;
margin-bottom:30px;
}

#mindx-medical-necessity-checker .section{
background:white;
padding:20px;
border-radius:14px;
margin-bottom:16px;
}

#mindx-medical-necessity-checker h3{
color:#17314f;
font-size:18px;
margin-top:0;
margin-bottom:15px;
}

#mindx-medical-necessity-checker label{
display:block;
margin-bottom:11px;
line-height:1.6;
color:#374151;
cursor:pointer;
}

#mindx-medical-necessity-checker input[type=""checkbox""]{
margin-right:10px;
}

#mindx-medical-necessity-checker button{
