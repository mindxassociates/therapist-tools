"<div id=""mindx-caseload-calculator"">

  <h2>Sustainable Caseload Calculator for Therapists</h2>

  <div class=""subtitle"">
    Estimate a sustainable weekly caseload based on your available work hours,
    documentation time, supervision, administrative tasks, and other responsibilities.
  </div>

  <!-- Weekly Hours -->

  <div class=""slider-header"">
    <label for=""weeklyHours"">Weekly Working Hours</label>
    <div class=""value"" id=""weeklyHoursValue"">40 hrs</div>
  </div>

  <input
    type=""range""
    id=""weeklyHours""
    min=""5""
    max=""60""
    value=""40""
    step=""1""
  >

  <!-- Session Length -->

  <div class=""input-group"">

    <label for=""sessionLength"">
      Average Session Length
    </label>

    <select id=""sessionLength"">

      <option value=""45"">45 minutes</option>
      <option value=""50"">50 minutes</option>
      <option value=""53"" selected>53 minutes</option>
      <option value=""60"">60 minutes</option>
      <option value=""90"">90 minutes</option>

    </select>

  </div>

  <!-- Documentation -->

  <div class=""slider-header"">
    <label for=""documentationTime"">
      Documentation Time per Session
    </label>

    <div class=""value"" id=""documentationValue"">
      10 min
    </div>

  </div>

  <input
    type=""range""
    id=""documentationTime""
    min=""0""
    max=""30""
    value=""10""
    step=""1""
  >

  <!-- Supervision -->

  <div class=""slider-header"">
    <label for=""supervisionHours"">
      Supervision / Consultation
    </label>

    <div class=""value"" id=""supervisionValue"">
      1 hr
    </div>

  </div>

  <input
    type=""range""
    id=""supervisionHours""
    min=""0""
    max=""10""
    value=""1""
    step=""1""
  >

  <!-- Admin -->

  <div class=""slider-header"">
    <label for=""adminHours"">
      Administrative Tasks
    </label>

    <div class=""value"" id=""adminValue"">
      2 hrs
    </div>

  </div>

  <input
    type=""range""
    id=""adminHours""
    min=""0""
    max=""20""
    value=""2""
    step=""1""
  >

  <!-- Meetings -->

  <div class=""slider-header"">
    <label for=""meetingHours"">
      Meetings
    </label>

    <div class=""value"" id=""meetingValue"">
      1 hr
    </div>

  </div>

  <input
    type=""range""
    id=""meetingHours""
    min=""0""
    max=""10""
    value=""1""
    step=""1""
  >

  <!-- Buffer -->

  <div class=""slider-header"">
    <label for=""bufferHours"">
      Buffer Time
    </label>

    <div class=""value"" id=""bufferValue"">
      2 hrs
    </div>

  </div>

  <input
    type=""range""
    id=""bufferHours""
    min=""0""
    max=""10""
    value=""2""
    step=""1""
  >

  <!-- Result -->

  <div class=""result"">

    <div class=""result-title"">
      Recommended Weekly Caseload
    </div>

    <div class=""income"" id=""caseloadResult"">
      13 Clients
    </div>

  </div>

</div>


<style>

#mindx-caseload-calculator{
  max-width:650px;
  margin:auto;
  padding:32px;
  background:#f8f9fc;
  border-radius:20px;
  font-family:'Segoe UI',sans-serif;
}

#mindx-caseload-calculator h2{
  text-align:center;
  color:#0d2d50;
  margin-bottom:10px;
  font-size:30px;
}

#mindx-caseload-calculator .subtitle{
  text-align:center;
  color:#6d7786;
  margin-bottom:30px;
  line-height:1.6;
}

#mindx-caseload-calculator label{
  display:block;
  font-weight:600;
  color:#17314f;
}

#mindx-caseload-calculator .slider-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:10px;
}

#mindx-caseload-calculator .value{
  font-weight:700;
  color:#0d2d50;
  font-size:18px;
}

#mindx-caseload-calculator input[type=""range""]{
  width:100%;
  margin-bottom:24px;
  accent-color:#0d2d50;
}

#mindx-caseload-calculator .input-group{
  margin-bottom:24px;
}

#mindx-caseload-calculator select{
  width:100%;
  padding:12px;
  border:1px solid #d9dee6;
  border-radius:10px;
  background:white;
  font-size:15px;
}

#mindx-caseload-calculator .result{
  background:#0d2d50;
  color:white;
  border-radius:16px;
  padding:30px;
  text-align:center;
  margin-top:20px;
}

#mindx-caseload-calculator .result-title{
  font-size:15px;
  opacity:.85;
  margin-bottom:8px;
}

#mindx-caseload-calculator .income{
  font-size:48px;
  font-weight:700;
}

@media(max-width:600px){

  #mindx-caseload-calculator{
    padding:24px 20px;
  }

  #mindx-caseload-calculator .income{
    font-size:40px;
  }

}

</style>


<script>

(function(){

  const weeklyHours =
    document.getElementById(""weeklyHours"");

  const sessionLength =
    document.getElementById(""sessionLength"");

  const documentationTime =
    document.getElementById(""documentationTime"");

  const supervisionHours =
    document.getElementById(""supervisionHours"");

  const adminHours =
    document.getElementById(""adminHours"");

  const meetingHours =
    document.getElementById(""meetingHours"");

  const bufferHours =
    document.getElementById(""bufferHours"");

  const result =
    document.getElementById(""caseloadResult"");

  function update(){

    const totalHours =
      parseFloat(weeklyHours.value);

    const sessionMinutes =
      parseFloat(sessionLength.value);

    const docMinutes =
      parseFloat(documentationTime.value);

    const supervision =
      parseFloat(supervisionHours.value);

    const admin =
      parseFloat(adminHours.value);

    const meetings =
      parseFloat(meetingHours.value);

    const buffer =
      parseFloat(bufferHours.value);

    document.getElementById(
      ""weeklyHoursValue""
    ).textContent =
      totalHours + "" hrs"";

    document.getElementById(
      ""documentationValue""
    ).textContent =
      docMinutes + "" min"";

    document.getElementById(
      ""supervisionValue""
    ).textContent =
      supervision + "" hr"";

    document.getElementById(
      ""adminValue""
    ).textContent =
      admin + "" hrs"";

    document.getElementById(
      ""meetingValue""
    ).textContent =
      meetings + "" hr"";

    document.getElementById(
      ""bufferValue""
    ).textContent =
      buffer + "" hrs"";

    const availableHours =
      totalHours -
      supervision -
      admin -
      meetings -
      buffer;

    const totalMinutesPerSession =
      sessionMinutes +
      docMinutes;

    const maxSessions =
      (availableHours * 60) /
      totalMinutesPerSession;

    const sustainableSessions =
      Math.max(
        0,
        Math.round(maxSessions * 0.85)
      );

    result.textContent =
      sustainableSessions +
      "" Clients"";

  }

  [
    weeklyHours,
    sessionLength,
    documentationTime,
    supervisionHours,
    adminHours,
    meetingHours,
    bufferHours
  ].forEach(function(el){

    el.addEventListener(
      ""input"",
      update
    );

    el.addEventListener(
      ""change"",
      update
    );

  });

  update();

})();

</script>"
