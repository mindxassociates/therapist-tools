        ></textarea>
      </div>

    </div>

    <button type=""button"" class=""primary-btn"" onclick=""addCE()"">
      Add CE Record
    </button>

  </div>

  <!-- Dashboard -->
  <div class=""section-card"">

    <div class=""section-title"">CE Progress</div>

    <div id=""dashboard""></div>

  </div>

  <!-- Records -->
  <div class=""section-card"">

    <div class=""records-header"">

      <div class=""section-title"">
        CE Records
      </div>

      <div class=""record-actions"">
        <button
          type=""button""
          class=""small-btn""
          onclick=""exportCSV()""
        >
          Export CSV
        </button>

        <button
          type=""button""
          class=""small-btn danger""
          onclick=""clearAllRecords()""
        >
          Clear All
        </button>
      </div>

    </div>

    <div id=""records""></div>

  </div>

  <div class=""privacy-note"">
    Your CE records are stored locally in your browser. This tool does not verify
    whether a course satisfies a particular licensing board's requirements.
    Always confirm current requirements directly with the applicable licensing board.
  </div>

</div>


