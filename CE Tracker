        </div>

      </div>

      <div class=""field full"">
        <label>Provider / Organization</label>
        <input
          type=""text""
          id=""courseProvider""
          placeholder=""e.g., APA, NASW, state association""
        >
      </div>

      <div class=""field full"">
        <label>Certificate / Notes</label>
        <textarea
          id=""courseNotes""
          rows=""3""
