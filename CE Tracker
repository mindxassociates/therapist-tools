"<div id=""mindx-ce-tracker"">

  <div class=""ce-header"">
    <h2>CE Tracker</h2>
    <p class=""ce-subtitle"">
      Track continuing education credits across multiple licenses, requirements, and renewal periods.
    </p>
  </div>

  <!-- License Setup -->
  <div class=""section-card"">
    <div class=""section-title"">License Requirements</div>

    <div id=""licenseList""></div>

    <button type=""button"" class=""secondary-btn"" onclick=""addLicense()"">
      + Add License
    </button>
  </div>

  <!-- Add CE -->
  <div class=""section-card"">

    <div class=""section-title"">Add CE Course</div>

    <div class=""form-grid"">

      <div class=""field full"">
        <label>Course / Training Name</label>
        <input
          type=""text""
          id=""courseName""
          placeholder=""e.g., Ethics in Telehealth""
        >
      </div>

      <div class=""field"">
        <label>Completion Date</label>
        <input type=""date"" id=""courseDate"">
      </div>

      <div class=""field"">
        <label>CE Hours</label>
        <input
          type=""number""
          id=""courseHours""
          min=""0""
