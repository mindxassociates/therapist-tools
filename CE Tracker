<script>

(function(){

const STORAGE_KEY = ""mindx_ce_tracker_v1"";

let licenses = [];
let records = [];


/* =========================
   Load Saved Data
========================= */

function loadData(){

  try {

    const saved =
      JSON.parse(localStorage.getItem(STORAGE_KEY));

    if(saved){

      licenses = saved.licenses || [];
      records = saved.records || [];

    }

  } catch(e){

    licenses = [];
    records = [];

  }

}


/* =========================
   Save Data
========================= */

function saveData(){

  localStorage.setItem(
    STORAGE_KEY,
    JSON.stringify({
      licenses: licenses,
      records: records
    })
  );

}


/* =========================
   Add License
========================= */

window.addLicense = function(){

  licenses.push({

    id: Date.now() + Math.random(),

    name: """",

    state: """",

    required: 30

  });

  saveData();

  renderLicenses();

  renderLicenseCheckboxes();

  renderDashboard();

};


/* =========================
   Remove License
========================= */

window.removeLicense = function(id){

  licenses =
    licenses.filter(
      license => license.id !== id
    );

  records.forEach(record => {

    record.licenses =
      record.licenses.filter(
        licenseId => licenseId !== id
      );

  });

  saveData();

  renderLicenses();

  renderLicenseCheckboxes();

  renderDashboard();

  renderRecords();

};


/* =========================
   Update License
========================= */

window.updateLicense = function(
  id,
  field,
  value
){

  const license =
    licenses.find(
      l => l.id === id
    );

  if(!license) return;

  if(field === ""required""){

    license.required =
      Number(value) || 0;

  } else {

    license[field] = value;

  }

  saveData();

  renderLicenseCheckboxes();

  renderDashboard();

};


/* =========================
   Render Licenses
========================= */

function renderLicenses(){

  const container =
    document.getElementById(""licenseList"");

  if(!licenses.length){

    container.innerHTML =
      '<div class=""empty-message"" style=""margin-bottom:15px;"">' +
      'Add your state license(s) to begin tracking CE requirements.' +
      '</div>';

    return;

  }

  container.innerHTML =
    licenses.map(license => `

      <div class=""license-item"">

        <div class=""license-grid"">

          <div class=""field"">

            <label>License Type</label>

            <input
              type=""text""
              value=""${escapeHTML(license.name)}""
              placeholder=""e.g., LPC""
              onchange=""updateLicense(${license.id}, 'name', this.value)""
            >

          </div>

          <div class=""field"">

            <label>State</label>

            <input
              type=""text""
              value=""${escapeHTML(license.state)}""
              placeholder=""e.g., Texas""
              onchange=""updateLicense(${license.id}, 'state', this.value)""
            >

          </div>

          <div class=""field"">

            <label>Required CE Hours</label>

            <input
              type=""number""
              min=""0""
              step=""0.25""
              value=""${license.required}""
              onchange=""updateLicense(${license.id}, 'required', this.value)""
            >

          </div>

          <button
            type=""button""
            class=""remove-license""
            onclick=""removeLicense(${license.id})""
          >
            Remove
          </button>

        </div>

      </div>

    `).join("""");

}


/* =========================
   License Checkboxes
========================= */

function renderLicenseCheckboxes(){

  const container =
    document.getElementById(
      ""licenseCheckboxes""
    );

  if(!licenses.length){

    container.innerHTML =
      '<div class=""empty-message"">' +
      'Add a license above to select where this CE applies.' +
      '</div>';

    return;

  }

  container.innerHTML =
    licenses.map(license => `

      <label class=""checkbox-item"">

        <input
          type=""checkbox""
          value=""${license.id}""
          class=""license-check""
        >

        <span>
          ${escapeHTML(
            license.name || ""Unnamed License""
          )}
          ${license.state
            ? "" — "" + escapeHTML(license.state)
            : """"
          }
        </span>

      </label>

    `).join("""");

}


/* =========================
   Add CE
========================= */

window.addCE = function(){

  const name =
    document.getElementById(
      ""courseName""
    ).value.trim();

  const date =
    document.getElementById(
      ""courseDate""
    ).value;

  const hours =
    Number(
      document.getElementById(
        ""courseHours""
      ).value
    );

  const category =
    document.getElementById(
      ""courseCategory""
    ).value;

  const provider =
    document.getElementById(
      ""courseProvider""
    ).value.trim();

  const notes =
    document.getElementById(
      ""courseNotes""
    ).value.trim();

  const selected =
    Array.from(
      document.querySelectorAll(
        "".license-check:checked""
      )
    ).map(
      checkbox => Number(checkbox.value)
    );


  if(!name){

    alert(
      ""Please enter a course or training name.""
    );

    return;

  }

  if(!hours || hours <= 0){

    alert(
      ""Please enter the number of CE hours.""
    );

    return;

  }


  records.push({

    id: Date.now() + Math.random(),

    name: name,

    date: date,

    hours: hours,

    category: category,

    provider: provider,

    notes: notes,

    licenses: selected

  });


  saveData();

  document.getElementById(
    ""courseName""
  ).value = """";

  document.getElementById(
    ""courseHours""
  ).value = """";

  document.getElementById(
    ""courseProvider""
  ).value = """";

  document.getElementById(
    ""courseNotes""
  ).value = """";

  document
    .querySelectorAll("".license-check"")
    .forEach(
      checkbox => checkbox.checked = false
    );


  renderDashboard();

  renderRecords();

};


/* =========================
   Remove Record
========================= */

window.removeRecord = function(id){

  records =
    records.filter(
      record => record.id !== id
    );

  saveData();

  renderDashboard();

  renderRecords();

};


/* =========================
   Dashboard
========================= */

function renderDashboard(){

  const container =
    document.getElementById(
      ""dashboard""
    );

  if(!licenses.length){

    container.innerHTML =
      '<div class=""empty-records"">' +
      'Add a license to see your CE progress.' +
      '</div>';

    return;

  }


  container.innerHTML =
    licenses.map(license => {

      const earned =
        records
          .filter(
            record =>
              record.licenses.includes(
                license.id
              )
          )
          .reduce(
            (sum, record) =>
              sum + Number(record.hours),
            0
          );

      const required =
        Number(license.required) || 0;

      const percentage =
        required > 0
          ? Math.min(
              100,
              (earned / required) * 100
            )
          : 0;


      return `

        <div class=""dashboard-card"">

          <div class=""dashboard-top"">

            <div class=""license-name"">

              ${escapeHTML(
                license.name ||
                ""Unnamed License""
              )}

              ${license.state
                ? "" — "" +
                  escapeHTML(
                    license.state
                  )
                : """"
              }

            </div>

            <div class=""hours"">

              ${earned.toFixed(2)}
              /
              ${required.toFixed(2)}
              hours

            </div>

          </div>

          <div class=""progress-bar"">

            <div
              class=""progress-fill""
              style=""width:${percentage}%""
            ></div>

          </div>

        </div>

      `;

    }).join("""");

}


/* =========================
   Records
========================= */

function renderRecords(){

  const container =
    document.getElementById(
      ""records""
    );

  if(!records.length){

    container.innerHTML =
      '<div class=""empty-records"">' +
      'No CE records added yet.' +
      '</div>';

    return;

  }


  const sorted =
    [...records].sort(
      (a,b) =>
        new Date(b.date || 0) -
        new Date(a.date || 0)
    );


  container.innerHTML =
    sorted.map(record => {

      const licenseNames =
        record.licenses
          .map(id => {

            const license =
              licenses.find(
                l => l.id === id
              );

            if(!license) return """";

            return (
              license.name ||
              ""Unnamed License""
            ) +
            (
              license.state
                ? "" — "" +
                  license.state
                : """"
            );

          })
          .filter(Boolean)
          .join("", "");


      return `

        <div class=""record"">

          <div class=""record-top"">

            <div>

              <div class=""record-name"">

                ${escapeHTML(
                  record.name
                )}

              </div>

              <div class=""record-meta"">

                ${record.date
                  ? escapeHTML(
                      record.date
                    )
                  : ""Date not entered""
                }

                ·

                ${escapeHTML(
                  record.category
                )}

                ${record.provider
                  ? "" · "" +
                    escapeHTML(
                      record.provider
                    )
                  : """"
                }

                <br>

                Applies to:
                ${
                  licenseNames ||
                  ""No license selected""
                }

              </div>

            </div>

            <div class=""record-hours"">

              ${Number(
                record.hours
              ).toFixed(2)} CE

            </div>

          </div>

          ${
            record.notes
              ? `
                <div class=""record-meta"">
                  ${escapeHTML(
                    record.notes
                  )}
                </div>
              `
              : """"
          }

          <button
            type=""button""
            class=""record-remove""
            onclick=""removeRecord(${record.id})""
          >
            Remove record
          </button>

        </div>

      `;

    }).join("""");

}


/* =========================
   Export CSV
========================= */

window.exportCSV = function(){

  if(!records.length){

    alert(
      ""There are no CE records to export.""
    );

    return;

  }


  const header = [

    ""Course / Training"",

    ""Completion Date"",

    ""CE Hours"",

    ""Category"",

    ""Provider"",

    ""Applicable Licenses"",

    ""Notes""

  ];


  const rows =
    records.map(record => {

      const licenseNames =
        record.licenses
          .map(id => {

            const license =
              licenses.find(
                l => l.id === id
              );

            if(!license) return """";

            return (
              license.name || """"
            ) +
            (
              license.state
                ? "" - "" +
                  license.state
                : """"
            );

          })
          .filter(Boolean)
          .join(""; "");


      return [

        record.name,

        record.date,

        record.hours,

        record.category,

        record.provider,

        licenseNames,

        record.notes

      ];

    });


  const csv =

    [header, ...rows]

      .map(row =>

        row.map(value =>

          `""${String(
            value || """"
          ).replace(
            /""/g,
            '""""'
          )}""`

        ).join("","")

      ).join(""\n"");


  const blob =
    new Blob(
      [csv],
      {
        type:
          ""text/csv;charset=utf-8;""
      }
    );


  const url =
    URL.createObjectURL(blob);

  const link =
    document.createElement(""a"");

  link.href = url;

  link.download =
    ""CE_Tracker_Records.csv"";

  document.body.appendChild(link);

  link.click();

  document.body.removeChild(link);

  URL.revokeObjectURL(url);

};


/* =========================
   Clear All
========================= */

window.clearAllRecords = function(){

  if(
    !confirm(
      ""Clear all licenses and CE records? This cannot be undone.""
    )
  ){

    return;

  }


  licenses = [];

  records = [];

  saveData();

  renderLicenses();

  renderLicenseCheckboxes();

  renderDashboard();

  renderRecords();

};


/* =========================
   HTML Escape
========================= */

function escapeHTML(value){

  return String(value || """")
    .replace(
      /&/g,
      ""&amp;""
    )
    .replace(
      /</g,
      ""&lt;""
    )
    .replace(
      />/g,
      ""&gt;""
    )
    .replace(
      /""/g,
      ""&quot;""
    )
    .replace(
      /'/g,
      ""&#039;""
    );

}


