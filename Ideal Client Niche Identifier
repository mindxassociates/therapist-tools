<script>

(function(){

  const container =
    document.getElementById(
      'mindx-niche-quiz'
    );

  const totalQuestions = 12;

  const questions =
    container.querySelectorAll(
      '.question'
    );

  const progressText =
    document.getElementById(
      'nicheProgressText'
    );

  const progressBar =
    document.getElementById(
      'nicheProgressBar'
    );

  const calculateButton =
    document.getElementById(
      'calculateNiche'
    );

  const results =
    document.getElementById(
      'nicheResults'
    );

  const resultCards =
    document.getElementById(
      'resultCards'
    );

  const restartButton =
    document.getElementById(
      'restartNiche'
    );


  function updateProgress(){

    let answered = 0;

    for(
      let i = 1;
      i <= totalQuestions;
      i++
    ){

      if(
        container.querySelector(
          'input[name=""q' +
          i +
          '""]:checked'
        )
      ){

        answered++;

      }

    }

    progressText.textContent =
      answered +
      ' / ' +
      totalQuestions;

    progressBar.style.width =
      (
        answered /
        totalQuestions *
        100
      ) + '%';

    calculateButton.disabled =
      answered !== totalQuestions;

  }


  container
    .querySelectorAll(
      'input[type=""radio""]'
    )
    .forEach(function(input){

      input.addEventListener(
        'change',
        updateProgress
      );

    });


  /*
   * NICHE DEFINITIONS
   */

  const niches = {

    anxiety:

      {
        name:
          'Anxiety & Stress Support',

        description:
          'A practice focused on adults experiencing anxiety, overwhelm, stress, perfectionism, or related concerns.',

        tags:
          [
            'anxiety',
            'youngAdults',
            'cbt',
            'skills',
            'telehealth',
            'privatePay',
            'workplace'
          ]
      },


    highAchiever:

      {
        name:
          'High-Achieving Professionals',

        description:
          'A niche serving professionals who are navigating burnout, perfectionism, work stress, identity, or pressure to perform.',

        tags:
          [
            'burnout',
            'youngAdults',
            'cbt',
            'integrative',
            'telehealth',
            'privatePay',
            'workplace'
          ]
      },


    trauma:

      {
        name:
          'Trauma & Recovery',

        description:
          'A practice centered on trauma-informed care for adults seeking support with trauma histories, emotional regulation, and recovery.',

        tags:
          [
            'trauma',
            'individual',
            'trauma',
            'somatic',
            'telehealth',
            'mixed',
            'providers'
          ]
      },


    relationships:

      {
        name:
          'Relationships & Couples',

        description:
          'A relationship-focused practice supporting couples and individuals working through communication, attachment, and relationship patterns.',

        tags:
          [
            'couples',
            'relationships',
            'couples',
            'couples',
            'hybrid',
            'privatePay',
            'providers'
          ]
      },


    parents:

      {
        name:
          'Perinatal & Parenting Support',

        description:
          'A niche focused on expectant parents, new parents, caregivers, and the emotional challenges surrounding parenthood.',

        tags:
          [
            'parents',
            'lifeTransition',
            'family',
            'integrative',
            'hybrid',
            'insurance',
            'medical'
          ]
      },


    teens:

      {
        name:
          'Teen & Young Adult Counseling',

        description:
          'A practice serving adolescents and young adults navigating anxiety, identity, relationships, school, and developmental transitions.',

        tags:
          [
            'teens',
            'anxiety',
            'individual',
            'cbt',
            'community',
            'insurance',
            'schools'
          ]
      },


    identity:

      {
        name:
          'Identity & Life Transitions',

        description:
          'A practice supporting adults navigating identity development, major life changes, transitions, and questions of meaning.',

        tags:
          [
            'adults',
            'lifeTransition',
            'individual',
            'integrative',
            'telehealth',
            'privatePay',
            'community'
          ]
      },


    lgbtq:

      {
        name:
          'LGBTQ+ Affirming Practice',

        description:
          'A practice intentionally serving LGBTQ+ adults, teens, couples, and families with affirming, culturally responsive care.',

        tags:
          [
            'adults',
            'identity',
            'individual',
            'integrative',
            'telehealth',
            'privatePay',
            'lgbtq'
          ]
      }

  };


  function calculateResults(){

    const scores = {};

    Object.keys(niches)
      .forEach(function(key){

        scores[key] = 0;

      });


    /*
     * Each answer contributes
     * to matching niche profiles.
     */

    for(
      let i = 1;
      i <= totalQuestions;
      i++
    ){

      const selected =
        container.querySelector(
          'input[name=""q' +
          i +
          '""]:checked'
        );

      if(!selected){
        continue;
      }

      const value =
        selected.value;


      Object.keys(niches)
        .forEach(function(key){

          const tags =
            niches[key].tags;

          if(
            tags.includes(value)
          ){

            scores[key] += 1;

          }

        });

    }


    /*
     * Additional contextual
     * scoring.
     */

    const selections = [];

    for(
      let i = 1;
      i <= totalQuestions;
      i++
    ){

      const selected =
        container.querySelector(
          'input[name=""q' +
          i +
          '""]:checked'
        );

      if(selected){
        selections.push(
          selected.value
        );
      }

    }


    /*
     * Strong niche combinations.
     */

    if(
      selections.includes('anxiety') &&
      selections.includes('youngAdults')
    ){

      scores.anxiety += 2;

    }


    if(
      selections.includes('burnout') &&
      selections.includes('youngAdults')
    ){

      scores.highAchiever += 2;

    }


    if(
      selections.includes('trauma') &&
      selections.includes('individual')
    ){

      scores.trauma += 2;

    }


    if(
      selections.includes('couples') &&
      selections.includes('relationships')
    ){

      scores.relationships += 2;

    }


    if(
      selections.includes('parents')
    ){

      scores.parents += 2;

    }


    if(
      selections.includes('teens')
    ){

      scores.teens += 2;

    }


    if(
      selections.includes('lgbtq')
    ){

      scores.lgbtq += 3;

    }


    if(
      selections.includes('identity') ||
      selections.includes('lifeTransition')
    ){

      scores.identity += 2;

    }


    /*
     * Sort by score.
     */

    const ranked =
      Object.keys(scores)
        .sort(function(a,b){

          return (
            scores[b] -
            scores[a]
          );

        })
        .slice(0,3);


    resultCards.innerHTML = '';


    ranked.forEach(
      function(key,index){

        const niche =
          niches[key];

        const card =
          document.createElement(
            'div'
          );

        card.className =
          'result-card';

        card.innerHTML =

          '<div class=""result-rank"">' +
          'MATCH ' +
          (index + 1) +
          '</div>' +

          '<div class=""result-name"">' +
          niche.name +
          '</div>' +

          '<div class=""result-description"">' +
          niche.description +
          '</div>';

        resultCards.appendChild(
          card
        );

      }
    );


    results.classList.add(
      'show'
    );

    calculateButton.style.display =
      'none';

    results.scrollIntoView({
      behavior:'smooth',
      block:'start'
    });

  }


  calculateButton.addEventListener(
    'click',
    calculateResults
  );


  restartButton.addEventListener(
    'click',
    function(){

      container
        .querySelectorAll(
          'input[type=""radio""]'
        )
        .forEach(function(input){

          input.checked = false;

        });

      results.classList.remove(
        'show'
      );

      resultCards.innerHTML = '';

      calculateButton.style.display =
        'block';

      updateProgress();

      container
        .scrollIntoView({
          behavior:'smooth',
          block:'start'
        });

    }
  );


  updateProgress();

})();

</script>"
