</style>


<script>

(function(){

  const container =
    document.getElementById(
      'mindx-private-practice-checklist'
    );

  const checkboxes =
    container.querySelectorAll(
      'input[type=""checkbox""]'
    );

  const progressText =
    document.getElementById(
      'ppProgressText'
    );

  const progressBar =
    document.getElementById(
      'ppProgressBar'
    );

  const completionBox =
    document.getElementById(
      'ppCompletionBox'
    );

  const resetButton =
    document.getElementById(
      'ppResetChecklist'
    );

  const storageKey =
    'mindx_private_practice_preparation_checklist';


  function update(){

    let completed = 0;

    checkboxes.forEach(
      function(box){

        if(box.checked){

          completed++;

        }

      }
    );


    const total =
      checkboxes.length;


    const percent =
      total === 0
        ? 0
        : Math.round(
            (
              completed /
              total
            ) * 100
          );


    progressText.textContent =
      completed +
      ' / ' +
      total +
      ' (' +
      percent +
      '%)';


    progressBar.style.width =
      percent + '%';


    completionBox.classList.toggle(
      'show',
      completed === total
    );


    saveProgress();

  }


  function saveProgress(){

    const state =
      Array.from(
        checkboxes
      ).map(
        function(box){

          return box.checked;

        }
      );


    try{

      localStorage.setItem(
        storageKey,
        JSON.stringify(state)
      );

    }catch(e){}

  }


  function loadProgress(){

    try{

      const saved =
        localStorage.getItem(
          storageKey
        );


      if(!saved){

        return;

      }


      const state =
        JSON.parse(saved);


      checkboxes.forEach(
        function(box,index){

          if(
            typeof state[index] !==
            'undefined'
          ){

            box.checked =
              state[index];

          }

        }
      );

    }catch(e){}

  }


  checkboxes.forEach(
    function(box){

      box.addEventListener(
        'change',
        update
      );

    }
  );


  resetButton.addEventListener(
    'click',
    function(){

      checkboxes.forEach(
        function(box){

          box.checked = false;

        }
      );


      update();

    }
  );


  loadProgress();

  update();

})();

</script>"
