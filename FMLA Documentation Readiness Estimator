<script>

function estimateFMLAReadiness(){

const questions = [

document.getElementById(""q1""),

document.getElementById(""q2""),

document.getElementById(""q3""),

document.getElementById(""q4""),

document.getElementById(""q5""),

document.getElementById(""q6""),

document.getElementById(""q7""),

document.getElementById(""q8""),

document.getElementById(""q9""),

document.getElementById(""q10"")

];


let total = 0;

questions.forEach(function(question){

total += Number(question.value);

});


const maximum = 30;

const percentage = Math.round(
(total / maximum) * 100
);


let status = """";

let description = """";

let checklist = [];


if(total <= 10){

status = ""More Information Needed"";

description =
""Your responses suggest that additional clinical information, documentation, or clarification may be needed before you consider completing FMLA-related paperwork."";

checklist = [

""Review the client's clinical history and current presentation."",

""Document functional limitations and their clinical basis."",

""Clarify the information requested on the specific form."",

""Determine whether additional assessment or documentation is needed.""

];

}


else if(total <= 20){

status = ""Review Before Completing"";

description =
""You appear to have some of the necessary clinical information, but several areas may benefit from additional review or documentation before completing the paperwork."";

checklist = [

""Confirm that the requested information is supported by the clinical record."",

""Clarify expected frequency, duration, or functional limitations when clinically appropriate."",

""Review the specific form and any required authorization."",

""Identify any questions that fall outside your scope or require additional information.""

];

}


else if(total <= 26){

status = ""Generally Prepared"";

description =
""Your responses suggest that you have a reasonably strong clinical foundation for considering the requested documentation. Review the specific form and remaining documentation requirements before completing it."";

checklist = [

""Confirm that all responses are supported by the clinical record."",

""Review the specific questions and requested information."",

""Confirm appropriate authorization or release requirements."",

""Document the clinical rationale for information provided.""

];

}


else{

status = ""Well Prepared Clinically"";

description =
""Your responses suggest that the clinical record and available information are relatively well developed for considering FMLA-related documentation. Continue to ensure that every response is clinically supported and within your scope."";

checklist = [

""Ensure all information is accurate and supported by the record."",

""Complete only the portions within your professional scope."",

""Confirm authorization and documentation requirements."",

""Retain appropriate documentation of the clinical basis for the information provided.""

];

}


/*
Build checklist
*/

let checklistHTML = """";

checklist.forEach(function(item){

checklistHTML +=
""<li>"" + item + ""</li>"";

});


document.getElementById(
""fmlaClinicianResult""
).innerHTML =

'<div class=""fmla-result"">' +

'<div class=""fmla-result-title"">' +
""Documentation Readiness"" +
""</div>"" +

'<div class=""fmla-score"">' +
percentage +
""%"" +
""</div>"" +

'<div class=""fmla-status"">' +
status +
""</div>"" +

'<div class=""fmla-description"">' +
description +
""</div>"" +

'<div class=""fmla-checklist"">' +

'<div class=""fmla-checklist-title"">' +
""Suggested Review Areas"" +
""</div>"" +

""<ul>"" +
checklistHTML +
""</ul>"" +

""</div>"" +

""</div>"";

}

</script>"
