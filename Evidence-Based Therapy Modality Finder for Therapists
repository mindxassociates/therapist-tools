<script>

(function(){

const modalities = {

CBT:{
name:""Cognitive Behavioral Therapy (CBT)"",
description:""A structured, present-focused approach that emphasizes the relationship between thoughts, emotions, and behaviors."",
scores:[3,3,3,1,0,0,1,3,1,3]
},

ACT:{
name:""Acceptance and Commitment Therapy (ACT)"",
description:""An experiential approach that emphasizes psychological flexibility, acceptance, mindfulness, and values-based action."",
scores:[2,1,1,3,1,1,1,2,2,2]
},

DBT:{
name:""Dialectical Behavior Therapy (DBT)"",
description:""A structured approach that combines behavioral strategies with mindfulness, emotion regulation, distress tolerance, and interpersonal effectiveness."",
scores:[3,1,3,3,1,0,2,3,3,3]
},

EMDR:{
name:""Eye Movement Desensitization and Reprocessing (EMDR)"",
description:""A trauma-focused approach designed to help clients process distressing experiences and associated memories."",
scores:[2,0,0,1,3,2,1,1,2,2]
},

IPT:{
name:""Interpersonal Psychotherapy (IPT)"",
description:""A time-limited approach that focuses on relationships, interpersonal difficulties, role transitions, grief, and social functioning."",
scores:[2,0,1,1,0,1,3,2,1,2]
},

Psychodynamic:{
name:""Psychodynamic Therapy"",
description:""An exploratory approach that examines patterns, relationships, emotions, and how past experiences may influence current functioning."",
scores:[0,0,0,1,1,3,3,0,2,4]
},

MI:{
name:""Motivational Interviewing (MI)"",
description:""A collaborative, client-centered approach that supports motivation and movement toward meaningful behavior change."",
scores:[2,1,1,2,0,1,2,3,1,2]
},

BehavioralActivation:{
name:""Behavioral Activation"",
description:""A practical behavioral approach that helps clients increase meaningful activity and reduce patterns of avoidance and withdrawal."",
scores:[3,2,3,1,0,0,1,3,1,3]
},

FamilySystems:{
name:""Family Systems Therapy"",
description:""A relational approach that explores interaction patterns and the ways relationships and family systems influence individual functioning."",
scores:[1,0,0,1,0,2,3,1,2,4]
},

SolutionFocused:{
name:""Solution-Focused Brief Therapy"",
description:""A strengths-based, future-oriented approach that emphasizes goals, existing resources, and practical steps toward change."",
scores:[3,1,2,2,0,0,1,3,1,1]
}

};


function getAnswers(){

let answers=[];

for(let i=1;i<=10;i++){

const selected =
document.querySelector(
'input[name=""q'+i+'""]:checked'
);

if(!selected){
return null;
}

answers.push(
Number(selected.value)
);

}

return answers;

}


function calculate(){

const answers=getAnswers();

if(!answers){

alert(""Please answer all questions before viewing your results."");

return;

}


let results=[];


Object.keys(modalities).forEach(function(key){

const modality=modalities[key];

let score=0;

for(let i=0;i<answers.length;i++){

/*
Compare the user's response
with the modality's preferred profile.
*/

const difference =
Math.abs(
answers[i]-modality.scores[i]
);

score +=
3-difference;

}

results.push({
name:modality.name,
description:modality.description,
score:score
});

});


results.sort(function(a,b){

return b.score-a.score;

});


const topFive =
results.slice(0,5);

const list =
document.getElementById(
""mx-result-list""
);

list.innerHTML="""";


topFive.forEach(function(item,index){

let match=""Good Match"";

if(index===0){
match=""Strongest Match"";
}
else if(index===1){
match=""Strong Match"";
}
else if(index===2){
match=""Strong Match"";
}

const card =
document.createElement(""div"");

card.className=""mx-result"";

card.innerHTML=

'<div class=""mx-rank"">#'+
(index+1)+
'</div>' +

'<div class=""mx-modality"">'+
item.name+
'</div>' +

'<div class=""mx-match"">'+
match+
'</div>' +

'<div class=""mx-description"">'+
item.description+
'</div>';

list.appendChild(card);

});


document.getElementById(
""mx-quiz""
).style.display=""none"";

document.getElementById(
""mx-results""
).style.display=""block"";

window.scrollTo({
top:document.getElementById(
""mx-modality-finder""
).offsetTop,
behavior:""smooth""
});

}


document.getElementById(
""mx-calculate""
).addEventListener(
""click"",
calculate
);


document.getElementById(
""mx-restart""
).addEventListener(
""click"",
function(){

document.getElementById(
""mx-results""
).style.display=""none"";

document.getElementById(
""mx-quiz""
).style.display=""block"";

document.querySelectorAll(
'#mx-quiz input[type=""radio""]'
).forEach(function(input){

input.checked=false;

});

window.scrollTo({
top:document.getElementById(
""mx-modality-finder""
).offsetTop,
behavior:""smooth""
});

});

})();

</script>"
