<script>

function calculateMarketing(){

const checks =
document.querySelectorAll(
'#marketingChecklist input[type=""checkbox""]'
);

const total = checks.length;

let completed = 0;

checks.forEach(function(check){

if(check.checked){

completed++;

}

});

const score =
Math.round((completed / total) * 100);

let status = """";
let message = """";

if(score < 50){

status = ""Marketing Foundation Needed"";

message =
""Your practice may benefit from strengthening its basic marketing foundation before adding more marketing channels."";

}
else if(score < 75){

status = ""Building Momentum"";

message =
""You have several important marketing pieces in place. Focus on filling the remaining gaps and creating a consistent system."";

}
else if(score < 90){

status = ""Strong Foundation"";

message =
""Your practice has a solid marketing foundation. Review your referral, visibility, and follow-up systems for additional opportunities."";

}
else{

status = ""Marketing Ready"";

message =
""Your practice has most of the core marketing elements in place. Continue monitoring what works and keep your systems current."";

}

document.getElementById(
""marketingResults""
).innerHTML =

'<div class=""marketing-result-box"">' +

'<div>Marketing Readiness</div>' +

'<div class=""marketing-score"">' +
score +
'%</div>' +

'<div class=""marketing-status"">' +
status +
'</div>' +

'<div class=""marketing-message"">' +
message +
'</div>' +

'</div>';

}

</script>"
