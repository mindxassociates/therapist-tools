</style>


<script>

function calculateTherapeuticReadiness(){

  const questions = [

    document.getElementById(""tr-q1""),

    document.getElementById(""tr-q2""),

    document.getElementById(""tr-q3""),

    document.getElementById(""tr-q4""),

    document.getElementById(""tr-q5""),

    document.getElementById(""tr-q6""),

    document.getElementById(""tr-q7""),

    document.getElementById(""tr-q8""),

    document.getElementById(""tr-q9""),

    document.getElementById(""tr-q10"")

  ];


  let total = 0;


  questions.forEach(function(question){

    total += Number(question.value);

  });


  const maximum = 30;

  const percentage = Math.round(
    (total / maximum) * 100
  );


  let status = """";

  let description = """";

  let focusAreas = [];


  if(total <= 9){

    status = ""Early Readiness / Significant Barriers"";

    description =
      ""The client may currently have limited readiness for active therapeutic work, or significant barriers may be affecting engagement. Consider slowing the pace, strengthening the therapeutic alliance, clarifying goals, and exploring barriers before increasing treatment demands."";

    focusAreas = [

      ""Explore ambivalence and the client's own reasons for seeking support."",

      ""Clarify treatment goals and expectations."",

      ""Identify practical, emotional, relational, or systemic barriers."",

      ""Prioritize engagement, safety, and therapeutic alliance.""

    ];

  }


  else if(total <= 17){

    status = ""Developing Readiness"";

    description =
      ""The client appears to have some readiness for therapeutic work, but motivation, engagement, goals, or barriers may still need attention. A collaborative and flexible treatment approach may be helpful."";

    focusAreas = [

      ""Strengthen collaborative treatment goals."",

      ""Explore areas of ambivalence without pressuring the client."",

      ""Identify barriers that may interfere with participation."",

      ""Use achievable steps to build engagement and confidence.""

    ];

  }


  else if(total <= 24){

    status = ""Moderate to Strong Readiness"";

    description =
      ""The client appears reasonably prepared for active therapeutic work. Most foundational factors for engagement are present, although specific areas may still benefit from ongoing attention."";

    focusAreas = [

      ""Continue monitoring engagement and treatment alliance."",

      ""Maintain collaborative goal-setting."",

      ""Address remaining barriers as they arise."",

      ""Gradually introduce interventions that match the client's goals and readiness.""

    ];

  }


  else{

    status = ""High Readiness for Active Therapeutic Work"";

    description =
      ""The client demonstrates strong indicators of readiness, engagement, and collaboration. The current presentation appears supportive of more active therapeutic work, while continuing to reassess fit and readiness over time."";

    focusAreas = [

      ""Maintain collaborative treatment planning."",

      ""Introduce interventions that align with the client's goals and preferences."",

      ""Monitor changes in motivation and engagement over time."",

      ""Continue adapting the pace and intensity of treatment to the client's needs.""

    ];

  }


  let focusHTML = """";


  focusAreas.forEach(function(item){

    focusHTML +=
      ""<li>"" + item + ""</li>"";

  });


  document.getElementById(
    ""therapeutic-readiness-result""
  ).innerHTML =

    '<div class=""tr-result-box"">' +

      '<div class=""tr-result-title"">' +
        ""Therapeutic Readiness"" +
      ""</div>"" +

      '<div class=""tr-score"">' +
        percentage +
        ""%"" +
      ""</div>"" +

      '<div class=""tr-status"">' +
        status +
      ""</div>"" +

      '<div class=""tr-description"">' +
        description +
      ""</div>"" +

      '<div class=""tr-focus"">' +

        '<div class=""tr-focus-title"">' +
          ""Suggested Clinical Focus"" +
        ""</div>"" +

        ""<ul>"" +
          focusHTML +
        ""</ul>"" +

      ""</div>"" +

    ""</div>"";

}

</script>"
