<script>

function calculateWalkTalkEN(){

const questions = [

document.getElementById(""wt-en-q1""),

document.getElementById(""wt-en-q2""),

document.getElementById(""wt-en-q3""),

document.getElementById(""wt-en-q4""),

document.getElementById(""wt-en-q5""),

document.getElementById(""wt-en-q6""),

document.getElementById(""wt-en-q7""),

document.getElementById(""wt-en-q8""),

document.getElementById(""wt-en-q9""),

document.getElementById(""wt-en-q10"")

];


let total = 0;


questions.forEach(function(question){

total += Number(question.value);

});


const maximum = 30;

const percentage = Math.round(
(total / maximum) * 100
);


let status = """";

let description = """";

let checklist = [];


if(total <= 10){

status = ""Not Ready for Direct Implementation"";

description =
""There may be significant clinical, privacy, safety, or practice-related concerns. Address key risks and develop appropriate procedures before considering Walk & Talk therapy."";

checklist = [

""Further assess the client's clinical suitability."",

""Review physical safety, route, and environmental risks."",

""Identify privacy and confidentiality risks in public settings."",

""Confirm applicable liability, organizational, and practice requirements.""

];

}


else if(total <= 20){

status = ""Further Assessment Recommended"";

description =
""Some foundational conditions are in place, but additional clinical, safety, privacy, or practice preparation may be needed before implementation."";

checklist = [

""Further assess whether the client is appropriate for a non-traditional therapy setting."",

""Develop weather, route, and emergency procedures."",

""Clarify privacy expectations and professional boundaries."",

""Review informed consent and related documentation.""

];

}


else if(total <= 26){

status = ""Generally Ready for Implementation"";

description =
""Overall conditions appear reasonably well established. Walk & Talk may be appropriate for selected clients, provided remaining safety, privacy, and practice considerations are addressed."";

checklist = [

""Confirm client-specific clinical suitability."",

""Complete appropriate informed consent and documentation."",

""Establish route, weather, and emergency procedures."",

""Continue reassessing whether Walk & Talk remains clinically appropriate.""

];

}


else{

status = ""High Practice Fit"";

description =
""Your current clinical, environmental, safety, and practice preparation suggests a strong overall fit for incorporating Walk & Talk therapy with appropriate clients. Continue to use client-specific clinical judgment and ongoing risk assessment."";

checklist = [

""Assess the suitability of Walk & Talk for each individual client."",

""Continue monitoring privacy, safety, and professional boundaries."",

""Reassess clinical fit periodically."",

""Review applicable state, organizational, and liability requirements as needed.""

];

}


let checklistHTML = """";


checklist.forEach(function(item){

checklistHTML +=
""<li>"" + item + ""</li>"";

});


document.getElementById(
""walk-talk-en-result""
).innerHTML =

'<div class=""walk-talk-result-box"">' +

'<div class=""walk-talk-result-title"">' +
""Walk &amp; Talk Practice Fit"" +
""</div>"" +

'<div class=""walk-talk-score"">' +
percentage +
""%"" +
""</div>"" +

'<div class=""walk-talk-status"">' +
status +
""</div>"" +

'<div class=""walk-talk-description"">' +
description +
""</div>"" +

'<div class=""walk-talk-checklist"">' +

'<div class=""walk-talk-checklist-title"">' +
""Recommended Review Areas"" +
""</div>"" +

""<ul>"" +
checklistHTML +
""</ul>"" +

""</div>"" +

""</div>"";

}

</script>"
