"<div id=""mindx-ethics-tool"">

  <div class=""ethics-header"">
    <h2>Clinical Ethics Decision Support Tool</h2>
    <p>
      A structured framework to help clinicians identify ethical considerations,
      compare options, and plan appropriate consultation.
    </p>
  </div>

  <div class=""ethics-notice"">
    <strong>Important:</strong> This tool does not determine what is ethical,
    provide legal advice, or replace professional judgment, supervision,
    consultation, applicable laws, regulations, or your profession's ethics code.
    Use it to structure your reasoning when an ethical dilemma is unclear.
  </div>

  <!-- STEP 1 -->
  <div class=""ethics-section"">
    <div class=""section-number"">1</div>

    <div class=""section-content"">
      <h3>Identify the Ethical Dilemma</h3>

      <label>What type of dilemma are you considering?</label>

      <select id=""ethicsType"">
        <option value=""confidentiality"">Confidentiality / Privacy</option>
        <option value=""safety"">Safety / Risk of Harm</option>
        <option value=""selfDetermination"">Client Self-Determination</option>
        <option value=""informedConsent"">Informed Consent</option>
        <option value=""boundaries"">Boundaries / Dual Relationship</option>
        <option value=""competence"">Scope of Practice / Competence</option>
        <option value=""documentation"">Documentation / Records</option>
        <option value=""technology"">Technology / Telehealth / AI</option>
        <option value=""family"">Family / Guardian Involvement</option>
        <option value=""cultural"">Cultural / Religious Values</option>
        <option value=""justice"">Justice / Access / Equity</option>
        <option value=""financial"">Financial / Insurance Conflict</option>
        <option value=""professional"">Professional Conflict</option>
        <option value=""other"">Other / Multiple Issues</option>
      </select>

      <label>Briefly describe the situation:</label>

      <textarea
        id=""ethicsDilemma""
        rows=""5""
        placeholder=""Describe the situation without entering unnecessary identifying information.""
      ></textarea>
    </div>
  </div>


  <!-- STEP 2 -->
  <div class=""ethics-section"">
    <div class=""section-number"">2</div>

    <div class=""section-content"">
      <h3>Identify the Stakeholders</h3>

      <p class=""helper"">
        Consider whose rights, wellbeing, privacy, or interests may be affected.
      </p>

      <div class=""checkbox-grid"">

        <label>
          <input type=""checkbox"" name=""stakeholder"" value=""Client"">
          Client
        </label>

        <label>
          <input type=""checkbox"" name=""stakeholder"" value=""Family"">
          Family / Significant Others
        </label>

        <label>
          <input type=""checkbox"" name=""stakeholder"" value=""Minor"">
          Minor / Dependent Person
        </label>

        <label>
          <input type=""checkbox"" name=""stakeholder"" value=""Clinician"">
          Clinician
        </label>

        <label>
          <input type=""checkbox"" name=""stakeholder"" value=""Supervisor"">
          Supervisor
        </label>

        <label>
          <input type=""checkbox"" name=""stakeholder"" value=""Practice"">
          Practice / Organization
        </label>

        <label>
          <input type=""checkbox"" name=""stakeholder"" value=""Healthcare"">
          Healthcare Team
        </label>

        <label>
          <input type=""checkbox"" name=""stakeholder"" value=""Community"">
          Community / Public
        </label>

      </div>
    </div>
  </div>


  <!-- STEP 3 -->
  <div class=""ethics-section"">
    <div class=""section-number"">3</div>

    <div class=""section-content"">

      <h3>Ethical Principles</h3>

      <p class=""helper"">
        Rate how strongly each principle appears to be involved in the dilemma.
        A higher score means the principle deserves greater attention—not
        necessarily that it should automatically determine the decision.
      </p>

      <div class=""principle"">

        <div class=""principle-header"">
          <strong>Autonomy / Self-Determination</strong>
          <span id=""autonomyValue"">3</span>
        </div>

        <input
          type=""range""
          id=""autonomy""
          min=""0""
          max=""5""
          value=""3""
          oninput=""updateEthicsValues()""
        >

        <small>
          Respect for the client's choices, preferences, capacity, and goals.
        </small>

      </div>


      <div class=""principle"">

        <div class=""principle-header"">
          <strong>Beneficence</strong>
          <span id=""beneficenceValue"">3</span>
        </div>

        <input
          type=""range""
          id=""beneficence""
          min=""0""
          max=""5""
          value=""3""
          oninput=""updateEthicsValues()""
        >

        <small>
          Promoting wellbeing and potential benefit.
        </small>

      </div>


      <div class=""principle"">

        <div class=""principle-header"">
          <strong>Nonmaleficence</strong>
          <span id=""nonmaleficenceValue"">3</span>
        </div>

        <input
          type=""range""
          id=""nonmaleficence""
          min=""0""
          max=""5""
          value=""3""
          oninput=""updateEthicsValues()""
        >

        <small>
          Preventing or minimizing foreseeable harm.
        </small>

      </div>


      <div class=""principle"">

        <div class=""principle-header"">
          <strong>Justice / Fairness</strong>
          <span id=""justiceValue"">3</span>
        </div>

        <input
          type=""range""
          id=""justice""
          min=""0""
          max=""5""
          value=""3""
          oninput=""updateEthicsValues()""
        >

        <small>
          Fairness, equitable access, and avoiding discriminatory treatment.
        </small>

      </div>


      <div class=""principle"">

        <div class=""principle-header"">
          <strong>Confidentiality / Privacy</strong>
          <span id=""confidentialityValue"">3</span>
        </div>

        <input
          type=""range""
          id=""confidentiality""
          min=""0""
          max=""5""
          value=""3""
          oninput=""updateEthicsValues()""
        >

        <small>
          Protecting private information and clarifying legitimate limits.
        </small>

      </div>


      <div class=""principle"">

        <div class=""principle-header"">
          <strong>Professional Integrity / Fidelity</strong>
          <span id=""integrityValue"">3</span>
        </div>

        <input
          type=""range""
          id=""integrity""
          min=""0""
          max=""5""
          value=""3""
          oninput=""updateEthicsValues()""
        >

        <small>
          Maintaining professional trust, responsibilities, boundaries, and integrity.
        </small>

      </div>

    </div>
  </div>


  <!-- STEP 4 -->
  <div class=""ethics-section"">
    <div class=""section-number"">4</div>

    <div class=""section-content"">

      <h3>Risk & Obligation Check</h3>

      <div class=""risk-grid"">

        <label>
          <span>Potential harm if no action is taken</span>
          <select id=""riskNoAction"">
            <option value=""0"">Low</option>
            <option value=""1"">Moderate</option>
            <option value=""2"">High</option>
            <option value=""3"">Immediate / Critical</option>
          </select>
        </label>

        <label>
          <span>Potential harm from taking action</span>
          <select id=""riskAction"">
            <option value=""0"">Low</option>
            <option value=""1"">Moderate</option>
            <option value=""2"">High</option>
            <option value=""3"">Immediate / Critical</option>
          </select>
        </label>

        <label>
          <span>Legal or regulatory obligation may apply</span>
          <select id=""legalRisk"">
            <option value=""0"">Unlikely / Unknown</option>
            <option value=""1"">Possibly</option>
            <option value=""2"">Likely</option>
            <option value=""3"">Clearly implicated</option>
          </select>
        </label>

        <label>
          <span>Client vulnerability / dependency</span>
          <select id=""vulnerability"">
            <option value=""0"">Low</option>
            <option value=""1"">Moderate</option>
            <option value=""2"">High</option>
            <option value=""3"">Very high</option>
          </select>
        </label>

      </div>

    </div>
  </div>


  <!-- STEP 5 -->
  <div class=""ethics-section"">
    <div class=""section-number"">5</div>

    <div class=""section-content"">

      <h3>Before Making a Decision</h3>

      <p class=""helper"">
        Select the steps you have already completed.
      </p>

      <div class=""checkbox-grid"">

        <label>
          <input type=""checkbox"" class=""consultation"">
          Reviewed applicable laws / regulations
        </label>

        <label>
          <input type=""checkbox"" class=""consultation"">
          Reviewed applicable ethics code
        </label>

        <label>
          <input type=""checkbox"" class=""consultation"">
          Reviewed informed consent
        </label>

        <label>
          <input type=""checkbox"" class=""consultation"">
          Consulted supervisor
        </label>

        <label>
          <input type=""checkbox"" class=""consultation"">
          Consulted qualified colleague
        </label>

        <label>
          <input type=""checkbox"" class=""consultation"">
          Considered cultural factors
        </label>

        <label>
          <input type=""checkbox"" class=""consultation"">
          Considered alternative actions
        </label>

        <label>
          <input type=""checkbox"" class=""consultation"">
          Considered the least restrictive option
        </label>

        <label>
          <input type=""checkbox"" class=""consultation"">
          Considered how the decision affects each stakeholder
        </label>

        <label>
          <input type=""checkbox"" class=""consultation"">
          Documented the ethical reasoning
        </label>

      </div>

    </div>
  </div>


  <!-- STEP 6 -->
  <button
    type=""button""
    class=""ethics-button""
    onclick=""generateEthicsAnalysis()""
  >
    Generate Ethical Decision Framework
  </button>


  <!-- RESULTS -->
  <div id=""ethicsResults"" class=""ethics-results""></div>


  <div class=""ethics-footer"">
    <strong>Important:</strong>
    Ethical decision-making often involves competing obligations rather than
    one universally correct answer. When significant risk, legal requirements,
    licensing concerns, or unresolved conflicts are present, seek appropriate
    professional consultation before acting.
  </div>

</div>


