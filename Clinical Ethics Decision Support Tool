<script>

function updateEthicsValues(){

  const ids = [
    ""autonomy"",
    ""beneficence"",
    ""nonmaleficence"",
    ""justice"",
    ""confidentiality"",
    ""integrity""
  ];

  ids.forEach(function(id){

    const value =
      document.getElementById(id).value;

    document.getElementById(id+""Value"").textContent =
      value;

  });

}


function generateEthicsAnalysis(){

  const principles = [

    {
      id:""autonomy"",
      name:""Autonomy / Self-Determination""
    },

    {
      id:""beneficence"",
      name:""Beneficence""
    },

    {
      id:""nonmaleficence"",
      name:""Nonmaleficence""
    },

    {
      id:""justice"",
      name:""Justice / Fairness""
    },

    {
      id:""confidentiality"",
      name:""Confidentiality / Privacy""
    },

    {
      id:""integrity"",
      name:""Professional Integrity / Fidelity""
    }

  ];


  principles.forEach(function(p){

    p.score =
      parseInt(
        document.getElementById(p.id).value
      );

  });


  principles.sort(function(a,b){
    return b.score-a.score;
  });


  const topPrinciples =
    principles.filter(function(p){
      return p.score >= 4;
    });


  const mediumPrinciples =
    principles.filter(function(p){
      return p.score >= 2 && p.score < 4;
    });


  const noAction =
    parseInt(
      document.getElementById(""riskNoAction"").value
    );

  const actionRisk =
    parseInt(
      document.getElementById(""riskAction"").value
    );

  const legalRisk =
    parseInt(
      document.getElementById(""legalRisk"").value
    );

  const vulnerability =
    parseInt(
      document.getElementById(""vulnerability"").value
    );


  const checked =
    document.querySelectorAll(
      "".consultation:checked""
    ).length;


  let urgency =
    ""Routine ethical reflection"";

  if(
    legalRisk >= 2 ||
    noAction >= 3 ||
    actionRisk >= 3
  ){

    urgency =
      ""Higher-risk situation — consultation recommended before acting"";

  }
  else if(
    legalRisk === 1 ||
    noAction >= 2 ||
    actionRisk >= 2 ||
    vulnerability >= 2
  ){

    urgency =
      ""Additional consultation and careful review recommended"";

  }


  let principleHTML = """";

  if(topPrinciples.length){

    principleHTML =
      topPrinciples.map(function(p){
        return ""<li><strong>""+
          p.name+
          ""</strong> — high relevance based on your rating.</li>"";
      }).join("""");

  }
  else{

    principleHTML =
      ""<li>No principle was rated at the highest level. Consider whether the dilemma has been sufficiently defined.</li>"";

  }


  let considerations = [];


  if(
    principles.find(p=>p.id===""autonomy"").score >= 4
  ){

    considerations.push(
      ""Clarify the client's preferences, goals, understanding, and decision-making capacity before limiting self-determination.""
    );

  }


  if(
    principles.find(p=>p.id===""beneficence"").score >= 4
  ){

    considerations.push(
      ""Identify the potential benefits of each available option and whether the proposed action is reasonably expected to support the client's wellbeing.""
    );

  }


  if(
    principles.find(p=>p.id===""nonmaleficence"").score >= 4
  ){

    considerations.push(
      ""Compare foreseeable harms associated with both action and inaction rather than considering only one side of the dilemma.""
    );

  }


  if(
    principles.find(p=>p.id===""justice"").score >= 4
  ){

    considerations.push(
      ""Consider whether access, treatment, policies, or decision-making could create unfair or discriminatory effects.""
    );

  }


  if(
    principles.find(p=>p.id===""confidentiality"").score >= 4
  ){

    considerations.push(
      ""Clarify what information is private, what exceptions may apply, and what the client has been told about limits of confidentiality.""
    );

  }


  if(
    principles.find(p=>p.id===""integrity"").score >= 4
  ){

    considerations.push(
      ""Consider professional boundaries, competence, conflicts of interest, and whether the proposed action is consistent with applicable professional standards.""
    );

  }


  if(!considerations.length){

    considerations.push(
      ""Identify the competing professional obligations and examine each reasonable option before deciding.""
    );

  }


  let nextSteps = [

    ""Review the ethics code applicable to your profession and practice setting."",

    ""Check applicable federal, state, and local laws or regulations when relevant."",

    ""Consider the client's perspective, values, cultural context, and stated goals."",

    ""Identify at least one reasonable alternative to the action you are currently considering."",

    ""Document the relevant facts, alternatives considered, consultation obtained, and rationale for the decision.""

  ];


  if(checked < 3){

    nextSteps.unshift(
      ""Obtain additional consultation before finalizing the decision, especially if significant risk or competing obligations remain.""
    );

  }


  if(legalRisk >= 2){

    nextSteps.unshift(
      ""Because legal or regulatory obligations may be substantially implicated, obtain appropriate legal, regulatory, supervisory, or ethics consultation before acting.""
    );

  }


  if(noAction >= 3 || actionRisk >= 3){

    nextSteps.unshift(
      ""Because the potential for serious harm is elevated, prioritize an appropriate risk assessment and timely professional consultation.""
    );

  }


  const dilemma =
    document.getElementById(""ethicsDilemma"").value.trim();

  const type =
    document.getElementById(""ethicsType"");

  const typeText =
    type.options[type.selectedIndex].text;


  let stakeholders = [];

  document.querySelectorAll(
    'input[name=""stakeholder""]:checked'
  ).forEach(function(el){

    stakeholders.push(el.value);

  });


  if(!stakeholders.length){

    stakeholders.push(
      ""Stakeholders have not yet been identified.""
    );

  }


  let mediumHTML = """";

  if(mediumPrinciples.length){

    mediumHTML =
      ""<strong>Also consider:</strong> ""+
      mediumPrinciples.map(function(p){
        return p.name;
      }).join("", "");

  }


  const result = `

    <div class=""result-heading"">
      Ethical Decision Framework
    </div>


    <div class=""result-summary"">

      <strong>Dilemma category:</strong>
      ${escapeEthics(typeText)}

      ${
        dilemma
        ?
        ""<br><br><strong>Situation:</strong> ""+
        escapeEthics(dilemma)
        :
        """"
      }

      <br><br>

      <strong>Decision context:</strong>
      ${urgency}

    </div>


    <div class=""result-grid"">

      <div class=""result-box"">

        <strong>Highest-Relevance Principles</strong>

        <ul class=""result-list"">
          ${principleHTML}
        </ul>

        ${mediumHTML}

      </div>


      <div class=""result-box"">

        <strong>Stakeholders Identified</strong>

        <span>
          ${stakeholders.map(escapeEthics).join("", "")}
        </span>

      </div>

    </div>


    <h4>Key Questions to Consider</h4>

    <ul class=""result-list"">

      ${considerations.map(function(item){
        return ""<li>""+item+""</li>"";
      }).join("""")}

    </ul>


    <h4>Suggested Next Steps</h4>

    <ul class=""result-list"">

      ${nextSteps.map(function(item){
        return ""<li>""+item+""</li>"";
      }).join("""")}

    </ul>


    ${
      legalRisk >= 2 || noAction >= 3 || actionRisk >= 3
      ?
      `
      <div class=""warning"">

        <strong>Consultation Flag</strong><br>

        Your responses indicate a potentially higher-risk situation.
        Do not rely on this tool alone to resolve the dilemma.
        Consider timely consultation with an appropriate supervisor,
        ethics consultant, regulatory body, or legal professional,
        depending on the issue.

      </div>
      `
      :
      """"
    }


    <h4>Ethical Reasoning Documentation Prompt</h4>

    <div class=""documentation"">

      Document the relevant facts and stakeholders; identify the competing
      ethical principles and professional obligations; review applicable laws,
      regulations, policies, and ethics standards; consider the client's
      perspective and cultural context; identify reasonable alternatives;
