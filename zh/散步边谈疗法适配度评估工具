<script>

function calculateWalkTalkCN(){

const questions = [

document.getElementById(""wt-q1""),

document.getElementById(""wt-q2""),

document.getElementById(""wt-q3""),

document.getElementById(""wt-q4""),

document.getElementById(""wt-q5""),

document.getElementById(""wt-q6""),

document.getElementById(""wt-q7""),

document.getElementById(""wt-q8""),

document.getElementById(""wt-q9""),

document.getElementById(""wt-q10"")

];


let total = 0;


questions.forEach(function(question){

total += Number(question.value);

});


const maximum = 30;

const percentage = Math.round(
(total / maximum) * 100
);


let status = """";

let description = """";

let checklist = [];


if(total <= 10){

status = ""目前不建议直接实施"";

description =
""目前可能存在较明显的临床、隐私、安全或执业条件方面的问题。建议先解决关键风险和流程问题，再考虑实施 Walk & Talk。"";

checklist = [

""进一步评估来访者的临床适配度。"",

""确认身体安全、路线和环境风险。"",

""明确公共环境中的隐私风险及应对方式。"",

""确认保险、机构政策和适用的执业要求。""

];

}


else if(total <= 20){

status = ""建议进一步评估"";

description =
""部分条件已经具备，但仍存在需要进一步确认的因素。建议在正式实施前完成临床、安全、隐私和执业层面的准备。"";

checklist = [

""进一步评估来访者是否适合非传统咨询环境。"",

""完善路线、天气和紧急情况预案。"",

""明确隐私和专业边界。"",

""确认知情同意及相关文书。""

];

}


else if(total <= 26){

status = ""基本具备实施条件"";

description =
""整体条件较为成熟，可以考虑在适当个案中尝试 Walk & Talk。实施前仍建议逐项核对风险管理、隐私和执业要求。"";

checklist = [

""确认具体来访者的临床适配度。"",

""完成必要的知情同意和相关文书。"",

""确认路线、天气和紧急情况方案。"",

""定期重新评估 Walk & Talk 是否继续适合该来访者。""

];

}


else{

status = ""整体适配度较高"";

description =
""目前在临床、环境、安全和执业准备方面均表现出较高适配度，可以考虑将 Walk & Talk 纳入适当来访者的咨询方式。仍应根据个案情况持续进行风险评估。"";

checklist = [

""确认每位来访者是否适合这种咨询形式。"",

""持续关注隐私、安全和专业边界。"",

""定期重新评估临床适配度。"",

""根据所在州及执业保险要求更新相关流程。""

];

}


let checklistHTML = """";


checklist.forEach(function(item){

checklistHTML +=
""<li>"" + item + ""</li>"";

});


document.getElementById(
""walk-talk-cn-result""
).innerHTML =

'<div class=""walk-talk-result-box"">' +

'<div class=""walk-talk-result-title"">' +
""Walk &amp; Talk 适配度"" +
""</div>"" +

'<div class=""walk-talk-score"">' +
percentage +
""%"" +
""</div>"" +

'<div class=""walk-talk-status"">' +
status +
""</div>"" +

'<div class=""walk-talk-description"">' +
description +
""</div>"" +

'<div class=""walk-talk-checklist"">' +

'<div class=""walk-talk-checklist-title"">' +
""建议审核项目"" +
""</div>"" +

""<ul>"" +
checklistHTML +
""</ul>"" +

""</div>"" +

""</div>"";

}

</script>"
