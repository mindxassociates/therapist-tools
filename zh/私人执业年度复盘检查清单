<script>

function calculateAnnualReviewCN(){

const checks =
document.querySelectorAll(
'#annualReviewFormCN input[type=""checkbox""]'
);

const total = checks.length;

let completed = 0;

checks.forEach(function(check){

if(check.checked){

completed++;

}

});

const score =
Math.round((completed / total) * 100);

let status = """";
let message = """";

if(score < 50){

status = ""需要进行年度复盘"";

message =
""目前仍有多个重要领域需要关注。可以安排专门的时间，从财务、工作系统、工作量和年度目标等方面进行系统复盘。"";

}
else if(score < 75){

status = ""年度复盘进行中"";

message =
""你已经完成了部分重要领域的复盘。可以进一步关注尚未完成的项目，并将复盘结果转化为下一年度的具体计划。"";

}
else if(score < 90){

status = ""年度复盘较完善"";

message =
""你的私人执业已经完成大部分重要领域的年度复盘。可以进一步将剩余项目转化为下一年度的具体目标。"";

}
else{

status = ""年度规划准备充分"";

message =
""你已经完成了大部分核心年度复盘项目，可以根据复盘结果进一步制定下一年度的重点计划。"";

}

document.getElementById(
""annualReviewResultsCN""
).innerHTML =

'<div class=""annual-result-box-cn"">' +

'<div>年度复盘完成度</div>' +

'<div class=""annual-score-cn"">' +
score +
'%</div>' +

'<div class=""annual-status-cn"">' +
status +
'</div>' +

'<div class=""annual-message-cn"">' +
message +
'</div>' +

'</div>';

}

</script>"
