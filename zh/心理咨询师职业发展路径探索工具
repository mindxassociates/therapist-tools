<script>

function calculateCareerPath(){

  const flexibility =
    parseInt(
      document.getElementById(""flexibility"").value,
      10
    );

  const business =
    parseInt(
      document.getElementById(""business"").value,
      10
    );

  const supervision =
    parseInt(
      document.getElementById(""supervision"").value,
      10
    );

  const risk =
    parseInt(
      document.getElementById(""risk"").value,
      10
    );

  const environment =
    document.getElementById(""environment"").value;

  const goal =
    document.getElementById(""goal"").value;


  const careers = [

    {
      id:""solo"",
      name:""独立执业 / 私人执业"",
      score:0,
      description:
        ""通常具有较高的工作自主性和时间安排灵活度，也能够建立自己的专业定位和服务模式。"",
      consider:
        ""需要考虑获客、市场推广、行政管理、收费与保险、合规、业务运营以及收入波动等责任。""
    },

    {
      id:""owner"",
      name:""团体执业机构负责人 / 创业者"",
      score:0,
      description:
        ""将临床专业、团队领导和机构经营结合起来，可以通过建立团队扩大服务范围和专业影响。"",
      consider:
        ""通常需要承担招聘、人员管理、财务、运营、合规、市场发展和组织领导等责任。""
    },

    {
      id:""supervisor"",
      name:""临床督导 / 专业导师"",
      score:0,
      description:
        ""通过督导、带教和专业发展支持其他临床工作者成长，适合对培养专业人员和临床领导感兴趣的人。"",
      consider:
        ""需要确认当地对临床督导资格、执照、培训和继续教育的具体要求。""
    },

    {
      id:""group"",
      name:""团体执业机构咨询师"",
      score:0,
      description:
        ""在保持一定临床自主性的同时获得团队、转介和行政支持，通常不需要承担完整的机构经营责任。"",
      consider:
        ""不同机构在收入分配、个案来源、排班自主性、福利、行政支持和专业发展机会方面可能差异很大。""
    },

    {
      id:""agency"",
      name:""机构 / 社区心理健康专业人员"",
      score:0,
      description:
        ""通常提供较明确的组织结构、团队合作、专业支持和较稳定的工作安排，并有机会接触多样化的临床需求。"",
      consider:
        ""需要权衡机构政策、工作量、行政要求、薪酬结构、工作自主性和职业晋升空间。""
    },

    {
      id:""educator"",
      name:""顾问 / 培训师 / 教育工作者"",
      score:0,
      description:
        ""可以通过专业咨询、课程培训、演讲、教学和内容开发，将临床经验转化为更广泛的专业影响。"",
      consider:
        ""通常需要逐步建立专业领域、教学能力、行业信誉、人脉以及稳定的项目或客户来源。""
    }

  ];


  /* 基础偏好评分 */

  careers[0].score +=
    flexibility * 3 +
    business * 4 +
    risk * 4;

  careers[1].score +=
    business * 5 +
    supervision * 3 +
    risk * 3;

  careers[2].score +=
    supervision * 5;

  careers[3].score +=
    flexibility * 2 +
    supervision * 2;

  careers[4].score +=
    (5 - risk) * 3;

  careers[5].score +=
    supervision * 3 +
    flexibility;


  /* 工作环境 */

  const environmentBonus = {
    solo:""solo"",
    leadership:""owner"",
    group:""group"",
    agency:""agency"",
    teaching:""educator""
  };

  const environmentCareer =
    careers.find(function(career){
      return career.id === environmentBonus[environment];
    });

  if(environmentCareer){
    environmentCareer.score += 12;
  }


  /* 职业目标 */

  if(goal === ""income""){
    addScore(""solo"",10);
    addScore(""owner"",10);
  }

  if(goal === ""leadership""){
    addScore(""owner"",12);
    addScore(""supervisor"",8);
  }

  if(goal === ""education""){
    addScore(""educator"",15);
    addScore(""supervisor"",8);
  }

  if(goal === ""stability""){
    addScore(""agency"",15);
    addScore(""group"",10);
  }

  if(goal === ""balance""){
    addScore(""group"",12);
    addScore(""solo"",6);
  }


  function addScore(id,points){

    const career =
      careers.find(function(item){
        return item.id === id;
      });

    if(career){
      career.score += points;
    }

  }


  careers.sort(function(a,b){
    return b.score - a.score;
  });


  const highestScore =
    careers[0].score;


  function getFitLabel(score){

    const ratio =
      score / highestScore;

    if(ratio >= .9){
      return ""高度匹配"";
    }

    if(ratio >= .75){
      return ""较高匹配"";
    }

    if(ratio >= .6){
      return ""值得探索"";
    }

    return ""可作为其他发展方向"";

  }


  let html = `

    <div class=""results-title"">
      你的职业路径探索结果
    </div>

    <div class=""results-intro"">
      以下结果反映的是你的职业偏好与不同发展路径之间的相对匹配程度，
      而不是对你的能力、未来成功率或实际收入的预测。
    </div>

  `;


  careers.slice(0,5).forEach(
    function(career,index){

      html += `

        <div class=""career-card"">

          <div class=""career-rank"">
            第 ${index + 1} 个值得探索的方向
          </div>

          <div class=""career-name"">
            ${career.name}
          </div>

          <div class=""career-fit"">
            ${getFitLabel(career.score)}
          </div>

          <div class=""career-description"">
            ${career.description}
          </div>

          <div class=""career-consider"">
            <strong>需要考虑：</strong>
            ${career.consider}
          </div>

        </div>

      `;

    }
  );


  html += `

    <div class=""career-summary"">

      <strong>如何理解结果：</strong><br>

      排名靠前并不意味着你应该立即选择这条职业路径。
      更有价值的问题是：这个方向为什么与你目前的偏好相符？
      它需要承担哪些责任？你愿意接受哪些取舍？
      以及它是否符合你未来 3–5 年希望建立的专业生活。

    </div>

  `;


  const results =
    document.getElementById(""careerResults"");

  results.innerHTML = html;

  results.classList.add(""show"");

  results.focus();

  results.scrollIntoView({
    behavior:""smooth"",
    block:""start""
  });

}

</script>"
