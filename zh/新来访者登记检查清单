</style>


<script>

(function () {

  function calculateOnboardingCN() {

    const checkboxes = document.querySelectorAll(
      '#onboardingFormCN input[type=""checkbox""]'
    );

    const total = checkboxes.length;

    let completed = 0;

    checkboxes.forEach(function (checkbox) {
      if (checkbox.checked) {
        completed++;
      }
    });

    const score = total > 0
      ? Math.round((completed / total) * 100)
      : 0;

    let status = '';
    let message = '';

    if (score < 60) {

      status = '登记流程尚未完成';

      message =
        '仍有多个重要项目需要完成。建议在首次正式咨询前补充相关资料和流程。';

    } else if (score < 90) {

      status = '登记即将完成';

      message =
        '大部分登记项目已经完成。建议检查剩余项目，并在正式开始咨询前完成必要步骤。';

    } else if (score < 100) {

      status = '基本完成';

      message =
        '登记流程基本完成。建议确认剩余项目后再开始正式咨询。';

    } else {

      status = '登记已完成';

      message =
        '所有清单项目均已完成，可以根据临床判断进入正式初始评估流程。';

    }

    document.getElementById('onboardingResultsCN').innerHTML =
      '<div class=""result-box"">' +
        '<div class=""result-title"">登记完成率</div>' +
        '<div class=""score"">' + score + '%</div>' +
        '<div class=""status"">' + status + '</div>' +
        '<div class=""result-message"">' + message + '</div>' +
      '</div>';
  }

  window.calculateOnboardingCN = calculateOnboardingCN;

})();

</script>"
