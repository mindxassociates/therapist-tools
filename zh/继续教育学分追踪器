<script>

(function(){

  const STORAGE_KEY = ""mindx_ce_tracker_cn_v1"";

  let records = JSON.parse(
    localStorage.getItem(STORAGE_KEY) || ""[]""
  );

  const states = [
    [""AL"",""Alabama""],
    [""AK"",""Alaska""],
    [""AZ"",""Arizona""],
    [""AR"",""Arkansas""],
    [""CA"",""California""],
    [""CO"",""Colorado""],
    [""CT"",""Connecticut""],
    [""FL"",""Florida""],
    [""GA"",""Georgia""],
    [""IL"",""Illinois""],
    [""MA"",""Massachusetts""],
    [""MD"",""Maryland""],
    [""MI"",""Michigan""],
    [""MN"",""Minnesota""],
    [""NC"",""North Carolina""],
    [""NJ"",""New Jersey""],
    [""NY"",""New York""],
    [""OH"",""Ohio""],
    [""OR"",""Oregon""],
    [""PA"",""Pennsylvania""],
    [""TX"",""Texas""],
    [""VA"",""Virginia""],
    [""WA"",""Washington""],
    [""Other"",""其他州""]
  ];

  const categoryNames = {
    ""General"":""一般继续教育"",
    ""Ethics"":""伦理 / 职业规范"",
    ""Cultural"":""文化能力 / 多元文化"",
    ""Human Trafficking"":""人口贩运"",
    ""Prescription Opioids"":""处方阿片类药物"",
    ""Suicide Prevention"":""自杀预防"",
    ""Domestic Violence"":""家庭暴力 / 亲密关系暴力"",
    ""Child Abuse"":""儿童虐待 / 忽视"",
    ""Human Abuse"":""虐待 / 忽视预防"",
    ""Veterans"":""退伍军人 / 军人心理健康"",
    ""Telehealth"":""远程医疗 / 远程心理咨询"",
    ""Substance Use"":""物质使用 / 成瘾"",
    ""Other"":""其他""
  };

  function save(){
    localStorage.setItem(
      STORAGE_KEY,
      JSON.stringify(records)
    );
  }

  function getSelectedStates(){
    return Array.from(
      document.querySelectorAll(
        ""#mindx-ce-tracker .state-item input:checked""
      )
    ).map(el => el.value);
  }

  window.addCE = function(){

    const name =
      document.getElementById(""courseName"").value.trim();

    const date =
      document.getElementById(""courseDate"").value;

    const credits =
      parseFloat(
        document.getElementById(""courseCredits"").value
      );

    const category =
      document.getElementById(""courseCategory"").value;

    const provider =
      document.getElementById(""courseProvider"").value.trim();

    const notes =
      document.getElementById(""courseNotes"").value.trim();

    const selectedStates =
      getSelectedStates();

    if(!name){
      alert(""请输入课程名称。"");
      return;
    }

    if(!credits || credits <= 0){
      alert(""请输入有效的 CE 学分。"");
      return;
    }

    records.push({
      id:Date.now(),
      name:name,
      date:date,
      credits:credits,
      category:category,
      provider:provider,
      states:selectedStates,
      notes:notes
    });

    save();

    document.getElementById(""courseName"").value="""";
    document.getElementById(""courseDate"").value="""";
    document.getElementById(""courseCredits"").value="""";
    document.getElementById(""courseProvider"").value="""";
    document.getElementById(""courseNotes"").value="""";

    document.querySelectorAll(
      ""#mindx-ce-tracker .state-item input""
    ).forEach(el => el.checked=false);

    renderRecords();
    updateDashboard();
    updateStateFilter();
  };

  window.deleteCE = function(id){

    records =
      records.filter(record => record.id !== id);

    save();

    renderRecords();
    updateDashboard();
    updateStateFilter();
  };

  window.clearAllCE = function(){

    if(!records.length) return;

    if(confirm(""确定要删除所有继续教育记录吗？"")){

      records=[];

      save();

      renderRecords();
      updateDashboard();
      updateStateFilter();
    }
  };

  function updateDashboard(){

    const totalCredits =
      records.reduce(
        (sum,r) => sum + Number(r.credits),
        0
      );

    const statesUsed = new Set();

    records.forEach(r=>{
      (r.states || []).forEach(s=>{
        statesUsed.add(s);
      });
    });

    const specialCategories = [
      ""Ethics"",
      ""Cultural"",
      ""Human Trafficking"",
      ""Prescription Opioids"",
      ""Suicide Prevention"",
      ""Domestic Violence"",
      ""Child Abuse"",
      ""Human Abuse"",
      ""Veterans"",
      ""Telehealth"",
      ""Substance Use""
    ];

    const specialCredits =
      records
        .filter(r =>
          specialCategories.includes(r.category)
        )
        .reduce(
          (sum,r) => sum + Number(r.credits),
          0
        );

    document.getElementById(""totalCredits"")
      .textContent =
      totalCredits.toFixed(2)
        .replace(/\.00$/,"""");

    document.getElementById(""totalCourses"")
      .textContent =
      records.length;

    document.getElementById(""totalStates"")
      .textContent =
      statesUsed.size;

    document.getElementById(""specialCredits"")
      .textContent =
      specialCredits.toFixed(2)
        .replace(/\.00$/,"""");
  }

  function updateStateFilter(){

    const select =
      document.getElementById(""filterState"");

    const current =
      select.value;

    const usedStates = new Set();

    records.forEach(r=>{
      (r.states || []).forEach(s=>{
        usedStates.add(s);
      });
    });

    select.innerHTML =
      '<option value=""all"">所有州</option>';

    states.forEach(([code,name])=>{

      if(usedStates.has(code)){

        const option =
          document.createElement(""option"");

        option.value=code;
        option.textContent =
          name + "" ("" + code + "")"";

        select.appendChild(option);
      }

    });

    if(
      Array.from(select.options)
        .some(o => o.value === current)
    ){
      select.value=current;
    }

  }

  window.renderRecords = function(){

    const container =
      document.getElementById(""recordsContainer"");

    const search =
      document.getElementById(""searchCE"")
        .value.toLowerCase();

    const category =
      document.getElementById(""filterCategory"")
        .value;

    const state =
      document.getElementById(""filterState"")
        .value;

    let filtered =
      records.filter(r=>{

        const matchesSearch =
          !search ||
          r.name.toLowerCase().includes(search) ||
          (r.provider || """")
            .toLowerCase()
            .includes(search);

        const matchesCategory =
          category === ""all"" ||
          r.category === category;

        const matchesState =
          state === ""all"" ||
          (r.states || []).includes(state);

        return (
          matchesSearch &&
          matchesCategory &&
          matchesState
        );

      });

    filtered.sort(
      (a,b) =>
        new Date(b.date || 0) -
        new Date(a.date || 0)
    );

    if(!filtered.length){

      container.innerHTML =
        '<div class=""empty-state"">' +
        '暂无符合条件的 CE 记录。' +
        '</div>';

      return;
    }

    container.innerHTML =
      filtered.map(r=>{

        const stateTags =
          (r.states || [])
            .map(code=>{
              const match =
                states.find(s=>s[0]===code);

              return match
                ? '<span class=""tag"">'+
                    match[1]+
                    ' ('+code+')</span>'
                : '';
            })
            .join("""");

        return `
          <div class=""record"">

            <div class=""record-top"">

              <div>
                <div class=""record-title"">
                  ${escapeHTML(r.name)}
                </div>

                <div class=""record-date"">
                  ${r.date || ""未填写日期""}
                  ${r.provider
                    ? "" · "" +
                      escapeHTML(r.provider)
                    : """"}
                </div>
              </div>

              <div class=""record-credits"">
                ${r.credits} CE
              </div>

            </div>

            <div class=""record-meta"">

              <span class=""tag"">
                ${categoryNames[r.category] || r.category}
              </span>

              ${stateTags}

            </div>

            ${
              r.notes
              ? `<div class=""record-notes"">
                  ${escapeHTML(r.notes)}
                 </div>`
              : """"
            }

            <button
              class=""record-delete""
              onclick=""deleteCE(${r.id})""
            >
              删除此记录
            </button>

          </div>
        `;

      }).join("""");

  };

  function escapeHTML(value){

    return String(value || """")
      .replace(/&/g,""&amp;"")
      .replace(/</g,""&lt;"")
      .replace(/>/g,""&gt;"")
      .replace(/""/g,""&quot;"")
      .replace(/'/g,""&#039;"");
  }

  window.exportCSV = function(){

    if(!records.length){

      alert(""目前没有可以导出的记录。"");
      return;
    }

    const rows = [
      [
        ""课程名称"",
        ""完成日期"",
        ""CE学分"",
        ""CE类别"",
        ""课程提供方"",
        ""适用州执照"",
        ""备注""
      ]
    ];

    records.forEach(r=>{

      const stateNames =
        (r.states || [])
          .map(code=>{
            const match =
              states.find(s=>s[0]===code);

            return match
              ? match[1]+"" (""+code+"")""
              : code;
          })
          .join(""; "");

      rows.push([
        r.name,
        r.date,
        r.credits,
        categoryNames[r.category] || r.category,
        r.provider || """",
        stateNames,
        r.notes || """"
      ]);

    });

    const csv =
      rows.map(row =>
        row.map(cell =>
          '""' +
          String(cell)
            .replace(/""/g,'""""') +
          '""'
        ).join("","")
      ).join(""\n"");

    const blob =
      new Blob(
        [""\uFEFF"" + csv],
        {type:""text/csv;charset=utf-8;""}
      );

    const url =
      URL.createObjectURL(blob);

    const link =
      document.createElement(""a"");

    link.href=url;
    link.download=
      ""继续教育学分记录.csv"";

    document.body.appendChild(link);

    link.click();

    document.body.removeChild(link);

    URL.revokeObjectURL(url);
  };

  renderRecords();
  updateDashboard();
  updateStateFilter();

})();
</script>"
