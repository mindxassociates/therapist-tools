      <input
        type=""text""
        id=""searchCE""
        placeholder=""搜索课程名称或提供方...""
        oninput=""renderRecords()""
      >

      <select id=""filterCategory"" onchange=""renderRecords()"">
        <option value=""all"">所有类别</option>
        <option value=""General"">一般继续教育</option>
        <option value=""Ethics"">伦理 / 职业规范</option>
        <option value=""Cultural"">文化能力 / 多元文化</option>
        <option value=""Human Trafficking"">人口贩运</option>
        <option value=""Prescription Opioids"">处方阿片类药物</option>
        <option value=""Suicide Prevention"">自杀预防</option>
        <option value=""Domestic Violence"">家庭暴力 / 亲密关系暴力</option>
        <option value=""Child Abuse"">儿童虐待 / 忽视</option>
        <option value=""Human Abuse"">虐待 / 忽视预防</option>
        <option value=""Veterans"">退伍军人 / 军人心理健康</option>
        <option value=""Telehealth"">远程医疗 / 远程心理咨询</option>
        <option value=""Substance Use"">物质使用 / 成瘾</option>
        <option value=""Other"">其他</option>
      </select>

      <select id=""filterState"" onchange=""renderRecords()"">
        <option value=""all"">所有州</option>
      </select>

    </div>

    <div id=""recordsContainer""></div>

  </div>

  <div class=""ce-footer"">
    本工具用于个人继续教育记录管理，不代表任何州执照委员会的官方续证要求。
    不同执照、专业类别及续证周期可能有不同要求，请以相关监管机构公布的最新规定为准。
  </div>

</div>


