          </label>

        </div>
      </div>

      <div class=""field full"">
        <label>备注</label>
        <textarea
          id=""courseNotes""
          placeholder=""例如：伦理 2 小时；可用于 TX / FL；证书已保存""
        ></textarea>
      </div>

    </div>

    <button class=""primary-btn"" onclick=""addCE()"">
