        <div class=""state-box"">

          <label class=""state-item"">
            <input type=""checkbox"" value=""AL"">
            Alabama (AL)
          </label>

          <label class=""state-item"">
            <input type=""checkbox"" value=""AK"">
            Alaska (AK)
          </label>

          <label class=""state-item"">
            <input type=""checkbox"" value=""AZ"">
            Arizona (AZ)
          </label>

          <label class=""state-item"">
            <input type=""checkbox"" value=""AR"">
            Arkansas (AR)
          </label>

          <label class=""state-item"">
            <input type=""checkbox"" value=""CA"">
            California (CA)
          </label>

          <label class=""state-item"">
            <input type=""checkbox"" value=""CO"">
            Colorado (CO)
          </label>

          <label class=""state-item"">
            <input type=""checkbox"" value=""CT"">
            Connecticut (CT)
          </label>

          <label class=""state-item"">
            <input type=""checkbox"" value=""FL"">
            Florida (FL)
          </label>

          <label class=""state-item"">
            <input type=""checkbox"" value=""GA"">
            Georgia (GA)
          </label>

          <label class=""state-item"">
            <input type=""checkbox"" value=""IL"">
            Illinois (IL)
          </label>

          <label class=""state-item"">
            <input type=""checkbox"" value=""MA"">
            Massachusetts (MA)
          </label>

          <label class=""state-item"">
            <input type=""checkbox"" value=""MD"">
            Maryland (MD)
          </label>

          <label class=""state-item"">
            <input type=""checkbox"" value=""MI"">
