            Minnesota (MN)
          </label>

          <label class=""state-item"">
            <input type=""checkbox"" value=""NC"">
            North Carolina (NC)
          </label>

          <label class=""state-item"">
            <input type=""checkbox"" value=""NJ"">
            New Jersey (NJ)
          </label>

          <label class=""state-item"">
            <input type=""checkbox"" value=""NY"">
            New York (NY)
          </label>

          <label class=""state-item"">
            <input type=""checkbox"" value=""OH"">
