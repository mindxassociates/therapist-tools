<script>

const insuranceRate =
document.getElementById(""insuranceRate"");

const privateRate =
document.getElementById(""privateRate"");

const sessions =
document.getElementById(""sessions"");

const weeks =
document.getElementById(""weeks"");

const insuranceCancel =
document.getElementById(""insuranceCancel"");

const privateCancel =
document.getElementById(""privateCancel"");

const cancelFee =
document.getElementById(""cancelFee"");


function money(value){

return ""$"" +
Math.round(value).toLocaleString();

}


function calculate(){

const insurance =
parseFloat(insuranceRate.value);

const privatePay =
parseFloat(privateRate.value);

const weeklySessions =
parseFloat(sessions.value);

const monthlyWeeks =
parseFloat(weeks.value);

const insuranceCancellation =
parseFloat(insuranceCancel.value) / 100;

const privateCancellation =
parseFloat(privateCancel.value) / 100;

const cancellationFee =
parseFloat(cancelFee.value);


/* Update displayed values */

document.getElementById(
""insuranceRateValue""
).innerText = money(insurance);


document.getElementById(
""privateRateValue""
).innerText = money(privatePay);


document.getElementById(
""sessionsValue""
).innerText = weeklySessions;


document.getElementById(
""weeksValue""
).innerText = monthlyWeeks;


document.getElementById(
""insuranceCancelValue""
).innerText =
Math.round(insuranceCancellation * 100) + ""%"";


document.getElementById(
""privateCancelValue""
).innerText =
Math.round(privateCancellation * 100) + ""%"";


document.getElementById(
""cancelFeeValue""
).innerText =
money(cancellationFee);


/*
Calculate effective revenue per scheduled session.

A cancelled session generates the cancellation fee
rather than the full session fee.
*/

const insuranceEffectiveRate =

(insurance * (1 - insuranceCancellation)) +

(cancellationFee * insuranceCancellation);


const privateEffectiveRate =

(privatePay * (1 - privateCancellation)) +

(cancellationFee * privateCancellation);


/*
Monthly income
*/

const insuranceMonthly =

insuranceEffectiveRate *
weeklySessions *
monthlyWeeks;


const privateMonthly =

privateEffectiveRate *
weeklySessions *
monthlyWeeks;


/*
Annual income assumes 12 months.
*/

const insuranceAnnual =
insuranceMonthly * 12;


const privateAnnual =
privateMonthly * 12;


const difference =
privateMonthly - insuranceMonthly;


/*
Update results
*/

document.getElementById(
""insuranceMonthly""
).innerText =
money(insuranceMonthly);


document.getElementById(
""privateMonthly""
).innerText =
money(privateMonthly);


document.getElementById(
""insuranceAnnual""
).innerText =
money(insuranceAnnual);


document.getElementById(
""privateAnnual""
).innerText =
money(privateAnnual);


document.getElementById(
""differenceOutput""
).innerText =
money(Math.abs(difference));


if(difference > 0){

document.getElementById(
""comparisonText""
).innerText =
""在当前假设下，自费咨询的预计月收入更高。"";

}

else if(difference < 0){

document.getElementById(
""comparisonText""
).innerText =
""在当前假设下，保险咨询的预计月收入更高。"";

}

else{

document.getElementById(
""comparisonText""
).innerText =
""在当前假设下，两种模式的预计月收入相近。"";

}

}


[
insuranceRate,
privateRate,
sessions,
weeks,
insuranceCancel,
privateCancel,
cancelFee

].forEach(function(element){

element.addEventListener(
""input"",
calculate
);

});


calculate();

</script>"
