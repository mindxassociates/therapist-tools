<script>

const checklist =
document.querySelectorAll(
'#mindx-tax-deduction-checklist input[type=""checkbox""]'
);

const totalItems =
checklist.length;


function updateChecklist(){

let checked = 0;

checklist.forEach(function(item){

if(item.checked){

checked++;

}

});


const percentage =
totalItems > 0
? (checked / totalItems) * 100
: 0;


document.getElementById(
""progressText""
).innerText =
checked + "" / "" + totalItems;


document.getElementById(
""progressFill""
).style.width =
percentage + ""%"";


document.getElementById(
""checkedCount""
).innerText =
checked;

}


checklist.forEach(function(item){

item.addEventListener(
""change"",
updateChecklist
);

});


function resetChecklist(){

checklist.forEach(function(item){

item.checked = false;

});

updateChecklist();

}


updateChecklist();

</script>"
