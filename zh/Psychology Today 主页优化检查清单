<script>

const checkboxes =
document.querySelectorAll(
'#mindx-pt-checklist .check-item'
);

function updateScore(){

const total =
checkboxes.length;

const checked =
document.querySelectorAll(
'#mindx-pt-checklist .check-item:checked'
).length;

const score =
Math.round(
(checked / total) * 100
);

document.getElementById(
'scoreOutput'
).innerHTML =
score + ' / 100';

let status = '';

if(score < 40){

status =
'🔴 仍有较大优化空间';

}
else if(score < 70){

status =
'🟡 基础良好，可进一步提升';

}
else if(score < 90){

status =
'🟢 已具备较强竞争力';

}
else{

status =
'🏆 优秀！主页已高度优化';

}

document.getElementById(
'statusOutput'
).innerHTML =
status;

}

checkboxes.forEach(box => {

box.addEventListener(
'change',
updateScore
);

});

updateScore();

</script>"
