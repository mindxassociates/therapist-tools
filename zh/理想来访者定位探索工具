<select id=""q5"">
<option value=""anxiety"">焦虑与压力管理</option>
<option value=""trauma"">创伤专长</option>
<option value=""adhd"">ADHD与神经多样性</option>
<option value=""relationship"">关系与伴侣咨询</option>
<option value=""youth"">儿童青少年咨询</option>
<option value=""immigrant"">华语与跨文化咨询</option>
</select>
</div>

<button type=""button"" onclick=""calculateNiche()"">
查看结果
</button>

</form>

