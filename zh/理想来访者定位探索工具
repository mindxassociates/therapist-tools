<script>

function calculateNiche(){

const answers = [
document.getElementById(""q1"").value,
document.getElementById(""q2"").value,
document.getElementById(""q3"").value,
document.getElementById(""q4"").value,
document.getElementById(""q5"").value
];

const scores = {};

answers.forEach(answer => {

scores[answer] = (scores[answer] || 0) + 1;

});

let winner =
Object.keys(scores).reduce((a,b)=>
scores[a] > scores[b] ? a : b
);

const results = {

anxiety:{
title:""焦虑与高成就人士方向"",
description:""您可能适合专注于焦虑、完美主义、职业压力、职业倦怠以及压力管理等领域。""
},

trauma:{
title:""创伤与复杂创伤方向"",
description:""您可能适合发展创伤治疗、EMDR、依恋创伤、复杂性创伤及原生家庭议题相关工作。""
},

adhd:{
title:""ADHD与神经多样性方向"",
description:""您可能适合服务ADHD、自闭症谱系成年人、执行功能困难以及神经多样性群体。""
},

relationship:{
title:""关系与伴侣咨询方向"",
description:""您可能适合发展亲密关系、伴侣咨询、沟通技巧、依恋模式以及婚姻相关工作。""
},

youth:{
title:""儿童青少年与家庭方向"",
description:""您可能适合服务儿童、青少年、家长支持、学校适应及家庭系统相关议题。""
},

immigrant:{
title:""华人移民与跨文化方向"",
description:""您可能适合服务华人移民、国际学生、双文化身份认同以及跨文化适应相关群体。""
}

};

document.getElementById(""resultName"").innerHTML =
results[winner].title;

document.getElementById(""resultDescription"").innerHTML =
results[winner].description;

document.getElementById(""resultBox"").style.display =
""block"";

document.getElementById(""resultBox"").scrollIntoView({
behavior:""smooth""
});

}

</script>"
