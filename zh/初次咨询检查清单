<script>

function calculateConsultChecklistCN(){

const checkboxes =
document.querySelectorAll(
'#consultFormCN input[type=""checkbox""]'
);

const total =
checkboxes.length;

let completed = 0;

checkboxes.forEach(function(box){

if(box.checked){

completed++;

}

});

const percentage =
Math.round(
(completed / total) * 100
);

let status = """";
let message = """";

if(percentage < 50){

status = ""需要进一步确认"";

message =
""仍有多个重要议题尚未讨论，建议在决定是否接案前进一步了解情况。"";

}
else if(percentage < 80){

status = ""大部分已完成"";

message =
""多数关键内容已经覆盖，可以回顾剩余项目并进一步确认匹配度。"";

}
else{

status = ""咨询评估已完成"";

message =
""已经完成大部分初次咨询评估内容，可根据临床判断决定是否进入正式 Intake。"";

}

document.getElementById(""resultsCN"").innerHTML =

'<div class=""result-box"">' +

'<div class=""result-title"">检查清单完成度</div>' +

'<div class=""result-score"">' +
percentage +
'%</div>' +

'<div class=""result-status"">' +
status +
'</div>' +

'<div class=""result-message"">' +
message +
'</div>' +

'</div>';

}

</script>"
