<script>

(function(){

const container =
document.getElementById(
""mindx-private-practice-checklist""
);

const checkboxes =
container.querySelectorAll(
'input[type=""checkbox""]'
);

const progressFill =
document.getElementById(
""ppProgressFill""
);

const progressText =
document.getElementById(
""ppProgressText""
);

const countText =
document.getElementById(
""ppCount""
);

const scoreElement =
document.getElementById(
""ppScore""
);

const statusElement =
document.getElementById(
""ppStatus""
);

const messageElement =
document.getElementById(
""ppMessage""
);


function updateChecklist(){

let completed = 0;

checkboxes.forEach(function(box){

if(box.checked){

completed++;

}

});


const total =
checkboxes.length;

const percent =
total > 0
? Math.round((completed / total) * 100)
: 0;


progressFill.style.width =
percent + ""%"";

progressText.textContent =
percent + ""%"";

countText.textContent =
""已完成 "" +
completed +
"" / "" +
total +
"" 项"";


scoreElement.textContent =
percent + ""%"";


let status = """";
let message = """";


if(percent === 0){

status = ""尚未开始"";

message =
""完成清单中的项目，逐步建立你的私人执业基础。"";

}
else if(percent < 40){

status = ""准备初期"";

message =
""你已经开始准备私人执业。建议优先完成执照、商业结构、财务和合规相关事项。"";

}
else if(percent < 70){

status = ""正在准备"";

message =
""基础框架正在形成。接下来可以重点完善文书、计费、来访者流程和技术系统。"";

}
else if(percent < 90){

status = ""接近准备完成"";

message =
""大部分核心事项已经准备完成。建议检查剩余项目，并确认运营流程能够稳定运行。"";

}
else if(percent < 100){

status = ""基本就绪"";

message =
""你的私人执业准备度较高。完成剩余项目后，可以进一步测试完整的来访者流程。"";

}
else{

status = ""准备完成"";

message =
""你已经完成这份基础准备清单。建议定期复查相关执照、保险、税务、文书和运营要求。"";

}


statusElement.textContent =
status;

messageElement.textContent =
message;


/* Update section counts */

const sections =
container.querySelectorAll(
"".pp-section""
);

sections.forEach(function(section){

const sectionChecks =
section.querySelectorAll(
'input[type=""checkbox""]'
);

let sectionCompleted = 0;

sectionChecks.forEach(function(box){

if(box.checked){

sectionCompleted++;

}

});

const count =
section.querySelector(
"".pp-section-count""
);

if(count){

count.textContent =
sectionCompleted +
"" / "" +
sectionChecks.length;

}

});


}


checkboxes.forEach(function(box){

box.addEventListener(
""change"",
updateChecklist
);

});


window.resetPrivatePracticeChecklist =
function(){

checkboxes.forEach(function(box){

box.checked = false;

});

updateChecklist();

};


updateChecklist();

})();

</script>"
