<script>

function checkMedicalNecessityCN(){

const checks =
document.querySelectorAll(
'#medicalNecessityFormCN input[type=""checkbox""]'
);

const total = checks.length;

let completed = 0;

checks.forEach(function(check){

if(check.checked){

completed++;

}

});

const score =
Math.round((completed / total) * 100);

let status = """";
let message = """";

if(score < 50){

status = ""存在较明显的文书缺口"";

message =
""目前可能缺少多个支持临床依据和医疗必要性的核心信息。建议在完成文书前进一步检查和补充。"";

}
else if(score < 75){

status = ""文书仍需加强"";

message =
""目前已经包含部分重要信息，但可能需要进一步明确症状、功能影响、临床干预和治疗目标之间的联系。"";

}
else if(score < 90){

status = ""文书记录较完整"";

message =
""大部分核心文书要素已经包含。建议进一步检查剩余项目，并确保临床依据具体、清晰。"";

}
else{

status = ""文书记录较完善"";

message =
""文书已经包含大部分支持清晰临床叙述的核心信息。仍建议结合具体保险公司和执业机构的要求进行最终检查。"";

}

document.getElementById(
""medicalNecessityResultsCN""
).innerHTML =

'<div class=""medical-result-box-cn"">' +

'<div>文书支持度</div>' +

'<div class=""medical-score-cn"">' +
score +
'%</div>' +

'<div class=""medical-status-cn"">' +
status +
'</div>' +

'<div class=""medical-message-cn"">' +
message +
'</div>' +

'<div class=""medical-warning-cn"">' +
'此评分仅反映文书完整程度，不代表已经满足医疗必要性要求，也不保证保险报销。' +
'</div>' +

'</div>';

}

</script>"
