<script>

const rate =
document.getElementById(""rate"");

const soloSessions =
document.getElementById(""soloSessions"");

const clinicians =
document.getElementById(""clinicians"");

const groupSessions =
document.getElementById(""groupSessions"");

const compensation =
document.getElementById(""compensation"");

const soloExpenses =
document.getElementById(""soloExpenses"");

const groupExpenses =
document.getElementById(""groupExpenses"");


function money(value){

return ""$"" +
Math.round(value).toLocaleString();

}


function calculate(){

const sessionRate =
parseFloat(rate.value);

const soloWeeklySessions =
parseFloat(soloSessions.value);

const clinicianCount =
parseFloat(clinicians.value);

const groupWeeklySessions =
parseFloat(groupSessions.value);

const compensationRate =
parseFloat(compensation.value) / 100;

const soloMonthlyExpenses =
parseFloat(soloExpenses.value);

const groupMonthlyExpenses =
parseFloat(groupExpenses.value);


/*
Assume 4 working weeks per month
*/

const weeksPerMonth = 4;


/*
SOLO PRACTICE
*/

const soloMonthlySessions =

soloWeeklySessions *
weeksPerMonth;


const soloRevenue =

soloMonthlySessions *
sessionRate;


const soloProfit =

soloRevenue -
soloMonthlyExpenses;


/*
GROUP PRACTICE
*/

const groupMonthlySessions =

clinicianCount *
groupWeeklySessions *
weeksPerMonth;


const groupRevenue =

groupMonthlySessions *
sessionRate;


const groupClinicianPay =

groupRevenue *
compensationRate;


const groupProfit =

groupRevenue -
groupClinicianPay -
groupMonthlyExpenses;


/*
Difference
*/

const difference =

groupProfit -
soloProfit;


/*
Update slider labels
*/

document.getElementById(
""rateValue""
).innerText =
money(sessionRate);


document.getElementById(
""soloSessionsValue""
).innerText =
soloWeeklySessions;


document.getElementById(
""cliniciansValue""
).innerText =
clinicianCount;


document.getElementById(
""groupSessionsValue""
).innerText =
groupWeeklySessions;


document.getElementById(
""compensationValue""
).innerText =
Math.round(compensationRate * 100) + ""%"";


document.getElementById(
""soloExpensesValue""
).innerText =
money(soloMonthlyExpenses);


document.getElementById(
""groupExpensesValue""
).innerText =
money(groupMonthlyExpenses);


/*
Update main results
*/

document.getElementById(
""soloProfit""
).innerText =
money(soloProfit);


document.getElementById(
""groupProfit""
).innerText =
money(groupProfit);


document.getElementById(
""difference""
).innerText =
money(Math.abs(difference));


/*
Comparison message
*/

if(difference > 0){

document.getElementById(
""comparisonText""
).innerText =
""当前参数下，团体执业预计经营利润更高。"";

}

else if(difference < 0){

document.getElementById(
""comparisonText""
).innerText =
""当前参数下，个人执业预计经营利润更高。"";

}

else{

document.getElementById(
""comparisonText""
).innerText =
""当前参数下，两种模式的预计经营利润相近。"";

}


/*
Update details
*/

document.getElementById(
""soloRevenue""
).innerText =
money(soloRevenue);


document.getElementById(
""soloCost""
).innerText =
money(soloMonthlyExpenses);


document.getElementById(
""groupRevenue""
).innerText =
money(groupRevenue);


document.getElementById(
""groupPay""
).innerText =
money(groupClinicianPay);


document.getElementById(
""groupCost""
).innerText =
money(groupMonthlyExpenses);

}


[
rate,
soloSessions,
clinicians,
groupSessions,
compensation,
soloExpenses,
groupExpenses

].forEach(function(element){

element.addEventListener(
""input"",
calculate
);

});


calculate();

</script>"
