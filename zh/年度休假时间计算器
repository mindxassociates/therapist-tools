<script>

const hours =
document.getElementById(""hours"");

const timeOff =
document.getElementById(""timeOff"");

const days =
document.getElementById(""days"");

const dailyHours =
document.getElementById(""dailyHours"");


function calculate(){

const weeklyHours =
parseFloat(hours.value);

const vacationWeeks =
parseFloat(timeOff.value);

const workDays =
parseFloat(days.value);

const hoursPerDay =
parseFloat(dailyHours.value);


/*
52 weeks in a year
*/

const workWeeks =
52 - vacationWeeks;


/*
Annual working hours
*/

const annualHours =
weeklyHours * workWeeks;


/*
Average monthly working hours
*/

const monthlyHours =
annualHours / 12;


/*
Update slider values
*/

document.getElementById(
""hoursValue""
).innerText =
weeklyHours + "" 小时"";


document.getElementById(
""timeOffValue""
).innerText =
vacationWeeks + "" 周"";


document.getElementById(
""daysValue""
).innerText =
workDays + "" 天"";


document.getElementById(
""dailyHoursValue""
).innerText =
hoursPerDay + "" 小时"";


/*
Update results
*/

document.getElementById(
""vacationOutput""
).innerText =
vacationWeeks + "" 周"";


document.getElementById(
""workWeeksOutput""
).innerText =
workWeeks + "" 周"";


document.getElementById(
""annualHoursOutput""
).innerText =
Math.round(annualHours).toLocaleString() +
"" 小时"";


document.getElementById(
""monthlyHoursOutput""
).innerText =
Math.round(monthlyHours) +
"" 小时"";


/*
Planning message
*/

document.getElementById(
""planningText""
).innerText =

""每年工作 "" +
workWeeks +
"" 周，休假 "" +
vacationWeeks +
"" 周；平均每周工作 "" +
weeklyHours +
"" 小时。"";

}


[
hours,
timeOff,
days,
dailyHours

].forEach(function(element){

element.addEventListener(
""input"",
calculate
);

});


calculate();

</script>"
