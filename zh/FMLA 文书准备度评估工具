<script>

function calculateFMLA_CN(){

const questions = [

document.getElementById(""fmla-cn-q1""),
document.getElementById(""fmla-cn-q2""),
document.getElementById(""fmla-cn-q3""),
document.getElementById(""fmla-cn-q4""),
document.getElementById(""fmla-cn-q5""),
document.getElementById(""fmla-cn-q6""),
document.getElementById(""fmla-cn-q7""),
document.getElementById(""fmla-cn-q8""),
document.getElementById(""fmla-cn-q9""),
document.getElementById(""fmla-cn-q10"")

];

let total = 0;

questions.forEach(function(question){
total += Number(question.value);
});

const maximum = 30;

const percentage = Math.round(
(total / maximum) * 100
);

let status = """";
let description = """";
let checklist = [];


if(total <= 10){

status = ""需要补充信息"";

description =
""目前的临床资料可能还不足以支持填写相关 FMLA 文书。建议先补充临床信息、功能受损情况或其他必要记录。"";

checklist = [

""查看来访者的临床历史和当前情况。"",
""记录功能受损情况及其临床依据。"",
""确认具体文书要求提供哪些信息。"",
""判断是否需要进一步评估或补充文书。""

];

}


else if(total <= 20){

status = ""建议进一步审核"";

description =
""您目前已经具备部分必要的临床信息，但在填写文书前，可能还需要进一步审核或补充部分记录。"";

checklist = [

""确认所提供的信息能够由临床文书支持。"",
""在临床依据充分的情况下，进一步明确功能受损、频率或持续时间。"",
""查看具体文书并确认授权要求。"",
""识别是否存在超出自身执业范围或专业能力的问题。""

];

}


else if(total <= 26){

status = ""基本具备准备条件"";

description =
""目前的临床信息基础较为充分，可以考虑进一步准备相关文书。填写前仍应逐项核对具体要求，并确保所有信息均有临床文书支持。"";

checklist = [

""确认所有信息均有临床文书支持。"",
""逐项查看文书中的具体问题和信息要求。"",
""确认适当的授权或信息披露要求。"",
""记录所提供信息的临床依据。""

];

}


else{

status = ""临床资料准备较充分"";

description =
""目前的临床文书和相关信息较为完整，可以考虑进入文书填写阶段。仍应确保每一项信息均准确、有临床依据，并且属于您的执业范围。"";

checklist = [

""确保所有信息准确，并有临床文书支持。"",
""仅填写属于自身专业执业范围的内容。"",
""确认适当的授权和文书要求。"",
""保留相关信息的临床依据和记录。""

];

}


let checklistHTML = """";

checklist.forEach(function(item){

checklistHTML +=
""<li>"" + item + ""</li>"";

});


document.getElementById(
""fmla-cn-result""
).innerHTML =

'<div class=""fmla-cn-result-box"">' +

'<div class=""fmla-cn-result-title"">' +
""文书准备度"" +
""</div>"" +

'<div class=""fmla-cn-score"">' +
percentage +
""%"" +
""</div>"" +

'<div class=""fmla-cn-status"">' +
status +
""</div>"" +

'<div class=""fmla-cn-description"">' +
description +
""</div>"" +

'<div class=""fmla-cn-checklist"">' +

'<div class=""fmla-cn-checklist-title"">' +
""建议审核项目"" +
""</div>"" +

""<ul>"" +
checklistHTML +
""</ul>"" +

""</div>"" +

""</div>"";

}

</script>"
