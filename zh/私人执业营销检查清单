<script>

function calculateMarketingCN(){

const checks =
document.querySelectorAll(
'#marketingChecklistCN input[type=""checkbox""]'
);

const total = checks.length;

let completed = 0;

checks.forEach(function(check){

if(check.checked){

completed++;

}

});

const score =
Math.round((completed / total) * 100);

let status = """";
let message = """";

if(score < 50){

status = ""营销基础仍需完善"";

message =
""你的私人执业可能需要先完善基础营销体系，再逐步增加其他营销渠道。"";

}
else if(score < 75){

status = ""正在建立营销体系"";

message =
""你已经完成了一些重要的营销准备。接下来可以重点补足尚未完成的环节，并建立持续的执行流程。"";

}
else if(score < 90){

status = ""营销基础较完善"";

message =
""你的私人执业已经具备较好的营销基础。可以进一步优化转介、曝光和潜在来访者跟进流程。"";

}
else{

status = ""营销准备度较高"";

message =
""你的私人执业已经完成大部分核心营销准备。接下来可以持续追踪有效渠道，并定期更新营销内容。"";

}

document.getElementById(
""marketingResultsCN""
).innerHTML =

'<div class=""marketing-result-box-cn"">' +

'<div>营销准备度</div>' +

'<div class=""marketing-score-cn"">' +
score +
'%</div>' +

'<div class=""marketing-status-cn"">' +
status +
'</div>' +

'<div class=""marketing-message-cn"">' +
message +
'</div>' +

'</div>';

}

</script>"
