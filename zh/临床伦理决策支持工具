<script>

(function(){

  const principles = [
    {
      id:""autonomy"",
      name:""自主 / 自决"",
      description:""尊重服务对象的选择、偏好、决策能力、个人目标与自我决定权。"",
      consideration:""澄清服务对象的偏好、目标、理解程度与决策能力，并审慎考虑任何可能限制其自决权的行动。""
    },
    {
      id:""beneficence"",
      name:""行善"",
      description:""促进服务对象的福祉，并考虑可能带来的合理益处。"",
      consideration:""比较不同方案可能带来的益处，并评估拟采取的行动是否有合理依据支持服务对象的福祉。""
    },
    {
      id:""nonmaleficence"",
      name:""不伤害"",
      description:""预防或尽可能减少可以合理预见的伤害。"",
      consideration:""同时比较采取行动与不采取行动可能产生的伤害，避免只评估伦理困境的一面。""
    },
    {
      id:""justice"",
      name:""公正 / 公平"",
      description:""关注公平待遇、服务可及性以及避免歧视或不平等影响。"",
      consideration:""考虑服务获取、待遇、政策或决策过程是否可能造成不公平、歧视或不成比例的影响。""
    },
    {
      id:""confidentiality"",
      name:""保密 / 隐私"",
      description:""保护私人信息，并明确保密原则及其适用限制。"",
      consideration:""明确哪些信息受到保密保护、可能适用哪些例外，以及服务对象是否已经了解保密原则及其限制。""
    },
    {
      id:""integrity"",
      name:""专业诚信 / 忠诚"",
      description:""维护专业信任、责任、界限、胜任力与专业诚信。"",
      consideration:""评估专业界限、胜任力、利益冲突以及拟采取的行动是否符合相关专业责任与标准。""
    }
  ];


  const container =
    document.getElementById(""principlesContainer"");


  principles.forEach(function(p){

    const wrapper =
      document.createElement(""div"");

    wrapper.className = ""principle"";

    wrapper.innerHTML = `
      <div class=""principle-header"">
        <strong>${p.name}</strong>
        <span
          class=""principle-value""
          id=""${p.id}Value""
          aria-live=""polite""
        >3</span>
      </div>

      <input
        type=""range""
        id=""${p.id}""
        min=""0""
        max=""5""
        value=""3""
        aria-label=""${p.name}相关程度""
      >

      <small>${p.description}</small>
    `;

    container.appendChild(wrapper);

  });


  principles.forEach(function(p){

    const slider =
      document.getElementById(p.id);

    slider.addEventListener(""input"", function(){

      document.getElementById(
        p.id + ""Value""
      ).textContent = slider.value;

    });

  });


  document
    .getElementById(""generateEthicsButton"")
    .addEventListener(
      ""click"",
      generateEthicsAnalysis
    );


  function generateEthicsAnalysis(){

    const scoredPrinciples =
      principles.map(function(p){

        return {
          ...p,
          score:parseInt(
            document.getElementById(p.id).value,
            10
          )
        };

      }).sort(function(a,b){
        return b.score - a.score;
      });


    const highPrinciples =
      scoredPrinciples.filter(function(p){
        return p.score >= 4;
      });


    const mediumPrinciples =
      scoredPrinciples.filter(function(p){
        return p.score >= 2 && p.score < 4;
      });


    const noAction =
      getNumber(""riskNoAction"");

    const actionRisk =
      getNumber(""riskAction"");

    const legalRisk =
      getNumber(""legalRisk"");

    const vulnerability =
      getNumber(""vulnerability"");


    const dilemma =
      document
        .getElementById(""ethicsDilemma"")
        .value
        .trim();


    const type =
      document.getElementById(""ethicsType"");

    const typeText =
      type.options[type.selectedIndex].text;


    const stakeholders =
      Array.from(
        document.querySelectorAll(
          'input[name=""stakeholder""]:checked'
        )
      ).map(function(el){
        return el.value;
      });


    const reviewSteps =
      Array.from(
        document.querySelectorAll("".review-step"")
      );


    const legalReviewed =
      reviewSteps.some(function(el){
        return (
          el.dataset.critical === ""legal"" &&
          el.checked
        );
      });


    const ethicsReviewed =
      reviewSteps.some(function(el){
        return (
          el.dataset.critical === ""ethics"" &&
          el.checked
        );
      });


    const consultationCompleted =
      reviewSteps.some(function(el){
        return (
          el.dataset.critical === ""consult"" &&
          el.checked
        );
      });


    let urgency =
      ""常规伦理反思"";


    if(
      legalRisk >= 2 ||
      noAction >= 3 ||
      actionRisk >= 3
    ){

      urgency =
        ""较高风险情境——建议在采取行动前进行及时的专业咨询"";

    }
    else if(
      legalRisk === 1 ||
      noAction >= 2 ||
      actionRisk >= 2 ||
      vulnerability >= 2
    ){

      urgency =
        ""建议进一步咨询并进行审慎评估"";

    }


    let principleHTML = """";


    if(highPrinciples.length){

      principleHTML =
        highPrinciples
          .map(function(p){

            return `
              <li>
                <strong>${escapeHTML(p.name)}</strong>
                ——根据你的评分，该原则具有较高相关性。
              </li>
            `;

          })
          .join("""");

    }
    else{

      principleHTML = `
        <li>
          目前没有伦理原则被评为高度相关。
          可以进一步确认伦理困境是否已经被充分界定。
        </li>
      `;

    }


    let considerations =
      highPrinciples.map(function(p){
        return p.consideration;
      });


    if(!considerations.length){

      considerations.push(
        ""明确当前相互竞争的伦理原则与专业义务，并比较至少两个合理可行的方案。""
      );

    }


    if(highPrinciples.length >= 2){

      considerations.unshift(
        ""当前可能存在多个高度相关且彼此竞争的伦理原则。避免仅依据单一原则做出决定，并明确说明不同原则之间需要如何权衡。""
      );

    }


    let nextSteps = [];


    if(
      (legalRisk >= 1) &&
      !legalReviewed
    ){

      nextSteps.push(
        ""确认并查阅与你的执业地点、专业身份和具体情境相关的法律与监管要求。""
      );

    }


    if(!ethicsReviewed){

      nextSteps.push(
        ""查阅所属专业及当前执业环境适用的伦理守则或专业标准。""
      );

    }


    if(
      (
        legalRisk >= 2 ||
        noAction >= 2 ||
        actionRisk >= 2 ||
        vulnerability >= 2
      ) &&
      !consultationCompleted
    ){

      nextSteps.push(
        ""在最终决定前考虑获得适当的督导、伦理咨询或其他具备相关胜任力的专业咨询。""
      );

    }


    nextSteps.push(
      ""考虑服务对象的观点、价值观、文化背景、社会环境与明确表达的目标。""
    );

    nextSteps.push(
      ""识别至少一个合理的替代方案，并比较采取行动与不采取行动可能产生的益处和伤害。""
    );

    nextSteps.push(
      ""记录相关事实、利益方、伦理原则、替代方案、所获得的咨询，以及最终决定的专业依据。""
    );


    const stakeholderText =
      stakeholders.length
        ? stakeholders.map(escapeHTML).join(""、"")
        : ""尚未明确选择相关利益方"";


    const mediumText =
      mediumPrinciples.length
        ? `
          <br><br>
          <strong>同时需要考虑：</strong>
          ${mediumPrinciples
            .map(function(p){
              return escapeHTML(p.name);
            })
            .join(""、"")}
        `
        : """";


    const higherRisk =
      (
        legalRisk >= 2 ||
        noAction >= 3 ||
        actionRisk >= 3
      );


    const result = `

      <div class=""result-heading"">
        伦理决策框架
      </div>

      <div class=""result-summary"">

        <strong>伦理困境类别：</strong>
        ${escapeHTML(typeText)}

        ${
          dilemma
            ? `
              <br><br>
              <strong>情况摘要：</strong>
              ${escapeHTML(dilemma)}
            `
            : """"
        }

        <br><br>

        <strong>当前决策情境：</strong>
        ${escapeHTML(urgency)}

      </div>


      <div class=""result-grid"">

        <div class=""result-box"">

          <strong>高度相关的伦理原则</strong>

          <ul class=""result-list"">
            ${principleHTML}
          </ul>

          <span>${mediumText}</span>

        </div>


        <div class=""result-box"">

          <strong>已识别的利益方</strong>

          <span>
            ${stakeholderText}
          </span>

        </div>

      </div>


      <h4>需要重点思考的问题</h4>

      <ul class=""result-list"">

        ${considerations
          .map(function(item){
            return `<li>${escapeHTML(item)}</li>`;
          })
          .join("""")}

      </ul>


      <h4>建议的下一步</h4>

      <ul class=""result-list"">

        ${nextSteps
          .map(function(item){
            return `<li>${escapeHTML(item)}</li>`;
          })
          .join("""")}

      </ul>


      ${
        higherRisk
          ? `
            <div class=""warning"">

              <strong>专业咨询提示</strong><br>

              你的回答显示当前情况可能涉及较高程度的风险、
              法律或监管义务，或行动与不行动均可能带来严重后果。
              不建议仅依赖本工具做出决定。
              请根据具体问题及时考虑督导、伦理咨询、
              相关监管机构或具备资质的法律专业人士。

            </div>
          `
          : """"
      }


      <h4>伦理决策记录提示</h4>

      <div class=""documentation"">

        建议记录：与伦理问题相关的事实和背景；
        涉及的主要利益方；相互竞争的伦理原则与专业义务；
        已查阅的法律、法规、机构政策及伦理标准；
        服务对象的观点、目标及文化与社会背景；
        已考虑的合理替代方案；
        各方案可能带来的益处与可预见风险；
        已获得的督导或专业咨询；
        以及最终决定和相应的专业判断依据。

      </div>

    `;


    const results =
      document.getElementById(""ethicsResults"");


    results.innerHTML = result;

    results.classList.add(""show"");

    results.focus();

    results.scrollIntoView({
      behavior:""smooth"",
      block:""start""
    });

  }


  function getNumber(id){

    return parseInt(
      document.getElementById(id).value,
      10
    );

  }


  function escapeHTML(value){

    return String(value)
      .replace(/&/g,""&amp;"")
      .replace(/</g,""&lt;"")
      .replace(/>/g,""&gt;"")
      .replace(/""/g,""&quot;"")
      .replace(/'/g,""&#039;"");

  }

})();

</script>"
