<script>

const salary =
document.getElementById(""salary"");

const payrollTax =
document.getElementById(""payrollTax"");

const benefits =
document.getElementById(""benefits"");

const contractorCost =
document.getElementById(""contractorCost"");

const clinicians =
document.getElementById(""clinicians"");


function money(value){

return ""$"" +
Math.round(value).toLocaleString();

}


function calculate(){

const annualSalary =
parseFloat(salary.value);

const payrollTaxRate =
parseFloat(payrollTax.value) / 100;

const benefitsRate =
parseFloat(benefits.value) / 100;

const contractorCostRate =
parseFloat(contractorCost.value) / 100;

const clinicianCount =
parseFloat(clinicians.value);


/*
W-2 calculations
*/

const w2PayrollTax =
annualSalary *
payrollTaxRate;

const w2Benefits =
annualSalary *
benefitsRate;

const w2CostPerClinician =
annualSalary +
w2PayrollTax +
w2Benefits;


/*
1099 calculations
*/

const contractorExtra =
annualSalary *
contractorCostRate;

const contractorCostPerClinician =
annualSalary +
contractorExtra;


/*
Total practice costs
*/

const w2Total =
w2CostPerClinician *
clinicianCount;

const contractorTotal =
contractorCostPerClinician *
clinicianCount;


/*
Difference
*/

const difference =
w2Total -
contractorTotal;


/*
Update slider labels
*/

document.getElementById(
""salaryValue""
).innerText =
money(annualSalary);


document.getElementById(
""payrollTaxValue""
).innerText =
Math.round(payrollTaxRate * 100) + ""%"";


document.getElementById(
""benefitsValue""
).innerText =
Math.round(benefitsRate * 100) + ""%"";


document.getElementById(
""contractorCostValue""
).innerText =
Math.round(contractorCostRate * 100) + ""%"";


document.getElementById(
""cliniciansValue""
).innerText =
clinicianCount;


/*
Update main results
*/

document.getElementById(
""w2Total""
).innerText =
money(w2Total);


document.getElementById(
""contractorTotal""
).innerText =
money(contractorTotal);


document.getElementById(
""difference""
).innerText =
money(Math.abs(difference));


/*
Comparison message
*/

if(difference > 0){

document.getElementById(
""comparisonText""
).innerText =
""当前假设下，1099 模式预计成本较低。"";

}

else if(difference < 0){

document.getElementById(
""comparisonText""
).innerText =
""当前假设下，W-2 模式预计成本较低。"";

}

else{

document.getElementById(
""comparisonText""
).innerText =
""当前假设下，两种模式的预计成本相同。"";

}


/*
Update details
*/

document.getElementById(
""w2Salary""
).innerText =
money(annualSalary * clinicianCount);


document.getElementById(
""w2PayrollTax""
).innerText =
money(w2PayrollTax * clinicianCount);


document.getElementById(
""w2Benefits""
).innerText =
money(w2Benefits * clinicianCount);


document.getElementById(
""contractorBase""
).innerText =
money(annualSalary * clinicianCount);


document.getElementById(
""contractorExtra""
).innerText =
money(contractorExtra * clinicianCount);

}


[
salary,
payrollTax,
benefits,
contractorCost,
clinicians

].forEach(function(element){

element.addEventListener(
""input"",
calculate
);

});


calculate();

</script>"
