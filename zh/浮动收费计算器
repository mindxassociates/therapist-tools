"<div style=""max-width: 650px; margin: auto; font-family: 'Open Sans', sans-serif; background: #f0f4fa; border-radius: 20px; padding: 30px; box-shadow: 0 10px 25px rgba(0,0,0,0.1);"">
  <h2 style=""color: #003366; text-align: center;"">浮动收费计算器</h2>

  <h4 style=""color: #003366; margin-top: 20px;"">咨询师设定</h4>
  <label style=""display: block; margin-bottom: 10px; font-weight: 600;"">每次基础咨询费用（美元）：
    <input type=""number"" id=""baseRate"" value=""150"" min=""20"" max=""500"" style=""width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #ccc; margin-top: 5px;"">
  </label>

  <label style=""display: block; margin-bottom: 10px; font-weight: 600;"">最低可接受费用（美元）：
    <input type=""number"" id=""minFee"" value=""50"" min=""0"" max=""500"" style=""width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #ccc; margin-top: 5px;"">
  </label>

  <label style=""display: block; margin-bottom: 10px; font-weight: 600;"">个人贫困线估值（美元）：
    <input type=""number"" id=""povertyLine"" value=""15000"" min=""10000"" max=""30000"" style=""width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #ccc; margin-top: 5px;"">
  </label>

  <h4 style=""color: #003366; margin-top: 30px;"">来访者信息</h4>
  <label style=""display: block; margin-bottom: 10px; font-weight: 600;"">家庭年收入（美元）：
    <input type=""number"" id=""income"" value=""40000"" min=""0"" style=""width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #ccc; margin-top: 5px;"">
  </label>

  <label style=""display: block; margin-bottom: 10px; font-weight: 600;"">家庭总人数：
    <input type=""number"" id=""householdSize"" value=""1"" min=""1"" style=""width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #ccc; margin-top: 5px;"">
  </label>

  <button onclick=""calculateSlidingScale()"" style=""background-color: #003366; color: white; padding: 14px 20px; border: none; border-radius: 10px; width: 100%; font-size: 18px; cursor: pointer; margin-top: 20px;"">计算建议费用</button><br><br>

  <div id=""scaleResult"" style=""font-weight: bold; text-align: center; font-size: 20px; color: #003366;""></div>
</div>

<script>
function calculateSlidingScale() {
  const baseRate = Number(document.getElementById('baseRate').value);
  const minFee = Number(document.getElementById('minFee').value);
  const povertyLine = Number(document.getElementById('povertyLine').value);
  const income = Number(document.getElementById('income').value);
  const householdSize = Number(document.getElementById('householdSize').value);

  const totalFPL = povertyLine + (householdSize - 1) * 5000;
  const ratio = income / totalFPL;

  let fee;
  if (ratio <= 1) {
    fee = minFee;
  } else if (ratio >= 2) {
    fee = baseRate;
  } else {
    fee = minFee + ((ratio - 1) / (2 - 1)) * (baseRate - minFee);
  }

  document.getElementById('scaleResult').textContent = `建议收费为：$${fee.toFixed(2)} / 次`;
}
</script>
