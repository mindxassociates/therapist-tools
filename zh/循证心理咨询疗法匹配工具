scores:[0,0,0,1,1,3,3,0,2,4]
},

MI:{
name:""动机式访谈（MI）"",
description:""一种合作式、以来访者为中心的方法，帮助来访者探索自身动机并推动有意义的行为改变。"",
scores:[2,1,1,2,0,1,2,3,1,2]
},

BehavioralActivation:{
name:""行为激活"",
description:""一种以行为为重点的方法，通过增加有意义的活动并减少回避和退缩模式来促进改变。"",
scores:[3,2,3,1,0,0,1,3,1,3]
},

FamilySystems:{
name:""家庭系统疗法"",
description:""一种关系取向的方法，探索互动模式以及家庭和关系系统如何影响个体的心理与行为。"",
scores:[1,0,0,1,0,2,3,1,2,4]
},

SolutionFocused:{
name:""焦点解决短期心理咨询"",
description:""一种优势取向、面向未来的方法，关注目标、已有资源以及实现改变的具体步骤。"",
scores:[3,1,2,2,0,0,1,3,1,1]
}

};


function getAnswers(){

let answers=[];

for(let i=1;i<=10;i++){

const selected =
document.querySelector(
'input[name=""cnq'+i+'""]:checked'
);

if(!selected){

return null;

}

answers.push(
Number(selected.value)
);

}

return answers;

}


function calculate(){

const answers=getAnswers();

if(!answers){

alert(""请先完成所有问题，再查看匹配结果。"");

return;

}


let results=[];


Object.keys(modalities).forEach(function(key){

const modality=modalities[key];

let score=0;


for(let i=0;i<answers.length;i++){

const difference =
Math.abs(
answers[i]-modality.scores[i]
);

score += 3-difference;

}


results.push({

name:modality.name,

description:modality.description,

score:score

});

});


results.sort(function(a,b){

return b.score-a.score;

});


const topFive =
results.slice(0,5);


const list =
document.getElementById(
""mx-result-list-cn""
);

list.innerHTML="""";


topFive.forEach(function(item,index){

let match=""较为匹配"";


if(index===0){

match=""最匹配"";

}
else if(index===1 || index===2){

match=""高度匹配"";

}


const card =
document.createElement(""div"");

card.className=""mx-result"";


card.innerHTML=

'<div class=""mx-rank"">第 '+
(index+1)+
' 名</div>' +

'<div class=""mx-modality"">'+
item.name+
'</div>' +

'<div class=""mx-match"">'+
match+
'</div>' +

'<div class=""mx-description"">'+
item.description+
'</div>';


list.appendChild(card);

});


document.getElementById(
""mx-quiz-cn""
).style.display=""none"";


document.getElementById(
""mx-results-cn""
).style.display=""block"";


window.scrollTo({

top:
document.getElementById(
""mx-modality-finder-cn""
).offsetTop,

behavior:""smooth""

});

}


document.getElementById(
""mx-calculate-cn""
).addEventListener(
""click"",
calculate
);


document.getElementById(
""mx-restart-cn""
).addEventListener(

""click"",

function(){

document.getElementById(
""mx-results-cn""
).style.display=""none"";


document.getElementById(
""mx-quiz-cn""
).style.display=""block"";


document.querySelectorAll(
'#mx-quiz-cn input[type=""radio""]'
).forEach(function(input){

input.checked=false;

});


window.scrollTo({

top:
document.getElementById(
""mx-modality-finder-cn""
).offsetTop,

behavior:""smooth""

});

}

);

})();

</script>"
