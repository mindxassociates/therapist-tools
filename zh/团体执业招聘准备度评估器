<script>

const referrals =
document.getElementById(""referrals"");

const caseload =
document.getElementById(""caseload"");

const reserve =
document.getElementById(""reserve"");

const referralSystem =
document.getElementById(""referralSystem"");

const onboarding =
document.getElementById(""onboarding"");

const financial =
document.getElementById(""financial"");

const management =
document.getElementById(""management"");

const risk =
document.getElementById(""risk"");


function calculateReadiness(){

const referralCount =
parseInt(referrals.value);

const currentCaseload =
parseInt(caseload.value);

const cashReserve =
parseInt(reserve.value);


/* Update slider values */

document.getElementById(
""referralValue""
).innerText =
referralCount;

document.getElementById(
""caseloadValue""
).innerText =
currentCaseload;

document.getElementById(
""reserveValue""
).innerText =
cashReserve;


/*
Referral demand score
Maximum 15
*/

let referralScore = 0;

if(referralCount >= 20){

referralScore = 15;

}else if(referralCount >= 10){

referralScore = 12;

}else if(referralCount >= 5){

referralScore = 8;

}else if(referralCount > 0){

referralScore = 4;

}


/*
Caseload score
Maximum 15

Higher existing caseload
generally indicates greater capacity pressure.
*/

let caseloadScore = 0;

if(currentCaseload >= 30){

caseloadScore = 15;

}else if(currentCaseload >= 25){

caseloadScore = 12;

}else if(currentCaseload >= 20){

caseloadScore = 9;

}else if(currentCaseload >= 15){

caseloadScore = 5;

}


/*
Cash reserve score
Maximum 15
*/

let reserveScore = 0;

if(cashReserve >= 9){

reserveScore = 15;

}else if(cashReserve >= 6){

reserveScore = 12;

}else if(cashReserve >= 3){

reserveScore = 9;

}else if(cashReserve >= 1){

reserveScore = 4;

}


/*
Other operational scores
*/

const operationalScore =

parseInt(referralSystem.value) +

parseInt(onboarding.value) +

parseInt(financial.value) +

parseInt(management.value) +

parseInt(risk.value);


/*
Maximum possible score:

Referral demand 15
Caseload 15
Cash reserve 15
Five operational factors 75

Total = 120
*/

const totalScore =

referralScore +
caseloadScore +
reserveScore +
operationalScore;


/*
Convert to percentage
*/

const percentage =

Math.round(
(totalScore / 120) * 100
);


document.getElementById(
""score""
).innerText =
percentage + ""%"";


let status = """";
let recommendation = """";


if(percentage < 40){

status =
""目前可能还不适合招聘"";

recommendation =
""建议先加强转介来源、现金流和基础运营系统，再考虑增加临床人员。"";

}

else if(percentage < 65){

status =
""正在接近招聘准备状态"";

recommendation =
""您已经具备部分基础条件。建议优先完善财务储备、入职流程和稳定的来访者来源。"";

}

else if(percentage < 80){

status =
""基本具备招聘条件"";

recommendation =
""您的执业已经具备较好的招聘基础。可以开始评估具体职位、薪酬结构和招聘计划。"";

}

else{

status =
""已经准备好招聘"";

recommendation =
""您的执业在需求、财务和运营方面已经具备较强基础，可以进一步推进招聘和团队扩展。"";

}


document.getElementById(
""status""
).innerText =
status;


document.getElementById(
""recommendation""
).innerText =
recommendation;

}


[
referrals,
caseload,
reserve,
referralSystem,
onboarding,
financial,
management,
risk

].forEach(function(element){

element.addEventListener(
""input"",
calculateReadiness
);

element.addEventListener(
""change"",
calculateReadiness
);

});


calculateReadiness();

</script>"
