  let activeCategory = ""all"";


  function normalize(text){

    return String(text || """")
      .toLowerCase()
      .normalize(""NFD"")
      .replace(/[\u0300-\u036f]/g,"""");

  }


  function getFiltered(){

    const query =
      normalize(
        document.getElementById(""icdSearch"").value
      );

    return diagnoses.filter(d=>{

      const categoryMatch =
        activeCategory === ""all"" ||
        d.category === activeCategory;

      if(!categoryMatch){
        return false;
      }

      if(!query){
        return true;
      }

      const searchable =
        normalize(
          d.code + "" "" +
          d.name + "" "" +
          d.cn + "" "" +
          d.keywords
        );

      return searchable.includes(query);

    });

  }


  function render(){

    const results =
      getFiltered();

    const container =
      document.getElementById(""icdResults"");

    const noResults =
      document.getElementById(""noResults"");

    const count =
      document.getElementById(""resultCount"");


    if(!results.length){

      container.innerHTML = """";

      count.textContent = """";

      noResults.style.display = ""block"";

      return;

    }


    noResults.style.display = ""none"";

    count.textContent =
      ""找到 "" + results.length + "" 个匹配结果"";


    container.innerHTML =
      results.map(d=>{

        return `
          <div class=""icd-card"">

            <div class=""icd-top"">

              <div>

                <div class=""diagnosis-name"">
                  ${escapeHTML(d.name)}
                </div>

                <div class=""diagnosis-cn"">
                  ${escapeHTML(d.cn)}
                </div>

                <div class=""diagnosis-category"">
                  ${categoryLabel(d.category)}
                </div>

              </div>

              <div class=""icd-code"">
                ${escapeHTML(d.code)}
              </div>

            </div>

          </div>
        `;

      }).join("""");

  }


  function categoryLabel(category){

    const labels = {

      depressive:""抑郁障碍"",

      anxiety:""焦虑障碍"",

      trauma:""创伤 / 应激相关障碍"",

      bipolar:""双相及相关障碍"",

      ocd:""强迫及相关障碍"",

      neurodevelopmental:""神经发育障碍"",

      substance:""物质使用相关障碍"",

      personality:""人格障碍"",

      eating:""进食障碍"",

      other:""其他心理健康诊断""

    };

    return labels[category] || ""其他"";

  }


  function escapeHTML(value){

    return String(value || """")
      .replace(/&/g,""&amp;"")
      .replace(/</g,""&lt;"")
      .replace(/>/g,""&gt;"")
      .replace(/""/g,""&quot;"")
      .replace(/'/g,""&#039;"");

  }


  window.filterCategory =
    function(category, button){

      activeCategory = category;

      document
        .querySelectorAll(
          ""#mindx-icd10-lookup .category-btn""
        )
        .forEach(btn=>{
          btn.classList.remove(""active"");
        });

      button.classList.add(""active"");

      render();

    };


  window.quickSearch =
    function(term){

      document.getElementById(""icdSearch"").value =
        term;

      activeCategory = ""all"";

      document
        .querySelectorAll(
          ""#mindx-icd10-lookup .category-btn""
        )
        .forEach(btn=>{
          btn.classList.remove(""active"");

          if(btn.dataset.category === ""all""){
            btn.classList.add(""active"");
          }
        });

      render();

      document
        .getElementById(""icdSearch"")
        .scrollIntoView({
          behavior:""smooth"",
          block:""center""
        });

    };


  window.clearICDSearch =
    function(){

      document.getElementById(""icdSearch"").value = """";

      activeCategory = ""all"";

      document
        .querySelectorAll(
          ""#mindx-icd10-lookup .category-btn""
        )
