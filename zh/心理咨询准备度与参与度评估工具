<script>

function calculateTherapeuticReadinessCN(){

  const questions = [

    document.getElementById(""tr-cn-q1""),

    document.getElementById(""tr-cn-q2""),

    document.getElementById(""tr-cn-q3""),

    document.getElementById(""tr-cn-q4""),

    document.getElementById(""tr-cn-q5""),

    document.getElementById(""tr-cn-q6""),

    document.getElementById(""tr-cn-q7""),

    document.getElementById(""tr-cn-q8""),

    document.getElementById(""tr-cn-q9""),

    document.getElementById(""tr-cn-q10"")

  ];


  let total = 0;


  questions.forEach(function(question){

    total += Number(question.value);

  });


  const maximum = 30;

  const percentage = Math.round(
    (total / maximum) * 100
  );


  let status = """";

  let description = """";

  let focusAreas = [];


  if(total <= 9){

    status = ""准备度较低 / 存在明显阻碍"";

    description =
      ""来访者目前可能尚未准备好进行较为主动的咨询工作，或存在明显影响参与的因素。此阶段可以适当放慢咨询节奏，加强咨询关系、澄清目标，并探索影响参与的阻碍。"";

    focusAreas = [

      ""探索来访者自身的改变动机和咨询需求。"",

      ""进一步澄清咨询目标与期待。"",

      ""识别现实、情绪、人际或其他可能影响参与的因素。"",

      ""优先建立安全感、咨询关系和合作基础。""

    ];

  }


  else if(total <= 17){

    status = ""准备度正在发展"";

    description =
      ""来访者已经表现出一定的咨询准备度，但动机、参与程度、目标或现实阻碍等方面仍可能需要进一步关注。较为灵活、协作性的咨询方式可能更为合适。"";

    focusAreas = [

      ""进一步建立共同认可的咨询目标。"",

      ""在不施加压力的情况下探索矛盾心理。"",

      ""识别可能影响持续参与的阻碍。"",

      ""通过可实现的小步骤逐渐增强参与感和信心。""

    ];

  }


  else if(total <= 24){

    status = ""中等至较高准备度"";

    description =
      ""来访者整体具备较好的咨询准备度。多数有利于积极参与咨询的基础条件已经具备，但仍可以根据具体情况持续关注个别领域。"";

    focusAreas = [

      ""持续关注咨询参与程度和咨询关系。"",

      ""保持共同制定咨询目标的过程。"",

      ""及时处理可能出现的参与障碍。"",

      ""根据来访者的目标和准备程度逐步引入相应的咨询方法。""

    ];

  }


  else{

    status = ""高度准备进行主动咨询工作"";

    description =
      ""来访者在咨询动机、参与程度和合作方面表现出较强的准备度。目前的状态较适合开展更主动的咨询工作，同时仍应随着咨询进展持续评估其需求和准备程度。"";

    focusAreas = [

      ""持续进行共同制定的咨询计划。"",

      ""选择与来访者目标和偏好相匹配的咨询方法。"",

      ""持续观察咨询动机和参与程度的变化。"",

      ""根据来访者的实际需求调整咨询节奏和干预强度。""

    ];

  }


  let focusHTML = """";


  focusAreas.forEach(function(item){

    focusHTML +=
      ""<li>"" + item + ""</li>"";

  });


  document.getElementById(
    ""therapeutic-readiness-result-cn""
  ).innerHTML =

    '<div class=""tr-cn-result-box"">' +

      '<div class=""tr-cn-result-title"">' +
        ""心理咨询准备度"" +
      ""</div>"" +

      '<div class=""tr-cn-score"">' +
        percentage +
        ""%"" +
      ""</div>"" +

      '<div class=""tr-cn-status"">' +
        status +
      ""</div>"" +

      '<div class=""tr-cn-description"">' +
        description +
      ""</div>"" +

      '<div class=""tr-cn-focus"">' +

        '<div class=""tr-cn-focus-title"">' +
          ""建议关注方向"" +
        ""</div>"" +

        ""<ul>"" +
          focusHTML +
        ""</ul>"" +

      ""</div>"" +

    ""</div>"";

}

</script>"
